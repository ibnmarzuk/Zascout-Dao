<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZA Scout | Quests</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Space Grotesk', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            blue: '#0070F3',
                            purple: '#8b5cf6',
                            dark: 'var(--bg-dark, #000000)',
                            light: 'var(--bg-light, #111111)',
                            subtle: 'var(--bg-subtle, #222222)',
                            text: 'var(--text-main, #EDEDED)',
                            muted: 'var(--text-muted, #A1A1AA)'
                        },
                        white: 'var(--text-white, #ffffff)',
                        black: 'var(--text-black, #000000)'
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-out forwards',
                        'slide-up': 'slideUp 0.5s ease-out forwards',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        html.light {
            --bg-dark: #f8fafc;
            --bg-light: #ffffff;
            --bg-subtle: #e2e8f0;
            --text-main: #0f172a;
            --text-muted: #475569;
            --text-white: #000000;
            --text-black: #ffffff;
        }

        body {
            background-color: theme('colors.brand.dark');
            color: theme('colors.brand.text');
            -webkit-font-smoothing: antialiased;
            transition: background-color 0.3s, color 0.3s;
        }

        .modal-backdrop {
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 100;
        }
        
        .glass-panel {
            background: rgba(17, 17, 17, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            transition: background-color 0.3s, border-color 0.3s;
        }
        
        html.light .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            border-color: rgba(0, 0, 0, 0.1);
        }

        .bento-card {
            background: linear-gradient(145deg, rgba(34,34,34,0.4) 0%, rgba(17,17,17,0.8) 100%);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }
        
        html.light .bento-card {
            background: linear-gradient(145deg, rgba(255,255,255,0.9) 0%, rgba(248,250,252,1) 100%);
            border-color: rgba(0,0,0,0.1);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .bento-card:hover {
            border-color: rgba(255,255,255,0.15);
            transform: translateY(-2px);
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
        }
        
        html.light .bento-card:hover {
            border-color: rgba(0,0,0,0.15);
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
        }

        .bento-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        html.light .bento-card::before {
            background: linear-gradient(90deg, transparent, rgba(0,0,0,0.1), transparent);
        }

        .bento-card:hover::before {
            opacity: 1;
        }

        .gradient-text {
            background: linear-gradient(to right, #fff, #a1a1aa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        html.light .gradient-text {
            background: linear-gradient(to right, #0f172a, #475569);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .glow-bg {
            position: fixed;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 800px;
            height: 400px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, rgba(0,0,0,0) 70%); /* Emerald glow for Quests page */
            pointer-events: none;
            z-index: -1;
        }
        
        html.light .glow-bg {
            opacity: 0.3;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: theme('colors.brand.dark'); }
        ::-webkit-scrollbar-thumb { background: theme('colors.brand.subtle'); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: theme('colors.brand.muted'); }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans relative">
    
    <div class="glow-bg animate-pulse-slow"></div>

    <!-- Navbar -->
    <nav class="sticky top-0 z-50 glass-panel border-b border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <a href="/" class="flex items-center gap-3 cursor-pointer">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-blue to-blue-800 flex items-center justify-center text-white shadow-[0_0_15px_rgba(0,112,243,0.4)]">
                        <i data-lucide="zap" class="w-4 h-4 text-white"></i>
                    </div>
                    <span class="font-display font-medium text-xl text-white tracking-tight">ZA Scout</span>
                </a>
                <div class="hidden md:flex items-center gap-8 bg-brand-light rounded-full px-6 py-2 border border-white/5">
                    <a href="/" class="nav-link text-brand-muted font-medium text-sm hover:text-white transition-colors">Explorer</a>
                    <a href="/quests" class="nav-link text-white font-medium text-sm transition-colors relative after:absolute after:-bottom-2 after:left-0 after:right-0 after:h-px after:bg-white after:rounded-full">Quests</a>
                    <a href="/mcp" class="nav-link text-brand-muted font-medium text-sm hover:text-white transition-colors">MCP Setup</a>
                </div>
                <div class="flex items-center gap-2 sm:gap-4">
                    <div class="hidden sm:flex flex-col items-end gap-1">
                        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-brand-purple/10 border border-brand-purple/20">
                            <div class="w-1.5 h-1.5 rounded-full bg-brand-purple animate-pulse"></div>
                            <span class="text-[10px] font-bold text-brand-purple uppercase tracking-tighter">LVL 1</span>
                        </div>
                        <div class="w-16 h-1 bg-brand-subtle rounded-full overflow-hidden">
                            <div class="h-full bg-brand-purple w-1/3 shadow-[0_0_8px_rgba(139,92,246,0.5)]"></div>
                        </div>
                    </div>
                    <button class="text-brand-muted hover:text-white transition-colors rounded-full p-2 hover:bg-white/5" id="themeToggle" title="Toggle Dark/Light Mode">
                        <i data-lucide="sun" class="w-4 h-4 hidden dark-icon"></i>
                        <i data-lucide="moon" class="w-4 h-4 light-icon"></i>
                    </button>
                    <button class="bg-white text-black hover:bg-gray-200 px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-medium transition-all shadow-[0_0_15px_rgba(255,255,255,0.2)] hover:scale-105 active:scale-95">
                        Connect
                    </button>
                    <button id="mobileMenuBtn" class="md:hidden text-brand-muted hover:text-white p-2">
                        <i data-lucide="menu" class="w-6 h-6"></i>
                    </button>
                </div>
            </div>
        </div>
        <!-- Mobile Menu -->
        <div id="mobileMenu" class="hidden md:hidden border-t border-white/5 bg-brand-dark/95 backdrop-blur-xl animate-fade-in">
            <div class="px-4 pt-2 pb-6 space-y-1">
                <a href="/" class="block px-3 py-4 text-base font-medium text-brand-muted hover:text-white border-b border-white/5 hover:bg-white/5 transition-colors">Explorer</a>
                <a href="/quests" class="block px-3 py-4 text-base font-medium text-white border-b border-white/5 hover:bg-white/5 transition-colors">Quests</a>
                <a href="/mcp" class="block px-3 py-4 text-base font-medium text-brand-muted hover:text-white hover:bg-white/5 transition-colors">MCP Setup</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full animate-fade-in">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div class="max-w-xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-widest mb-4">
                    <i data-lucide="crosshairs" class="w-3.5 h-3.5"></i> Active Missions
                </div>
                <h1 class="text-4xl md:text-5xl font-display font-bold gradient-text mb-4 tracking-tight">Community Quests</h1>
                <p class="text-brand-muted text-lg font-light">
                    Complete tasks, grow the community, and earn XP and rewards as a Zero Authority ambassador.
                </p>
            </div>
            
            <div class="bento-card px-6 py-4 flex items-center gap-6 self-start w-full md:w-auto">
                <div>
                    <div class="text-sm text-brand-muted font-medium mb-1">Your Rank</div>
                    <div class="font-display font-bold text-white text-xl">Scout Level 1</div>
                </div>
                <div class="w-px h-10 bg-white/10"></div>
                <div>
                    <div class="text-sm text-brand-muted font-medium mb-1">XP Earned</div>
                    <div class="font-display font-bold text-emerald-400 text-xl">0 / 500</div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-slide-up" style="animation-delay: 0.1s;">
            <!-- Quest 1 -->
            <div class="bento-card p-6 flex flex-col group hover:-translate-y-1 quest-card cursor-pointer" id="quest-discord" data-id="discord" data-current="0" data-target="5">
                <div class="flex justify-between items-start mb-6">
                    <div class="w-12 h-12 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center">
                        <i data-lucide="message-circle" class="w-6 h-6 text-orange-400"></i>
                    </div>
                    <div class="px-3 py-1 rounded bg-white/5 text-xs font-bold uppercase tracking-wider text-white">Daily</div>
                </div>
                <h3 class="text-xl font-display font-bold text-white mb-2">Discord Engagement</h3>
                <p class="text-sm text-brand-muted mb-6 flex-grow">Participate in #general chat and help onboard new members into the DAO.</p>
                
                <div class="space-y-4 w-full">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-brand-muted line-clamp-1">Progress</span>
                        <span class="text-emerald-400 font-bold progress-label">0 / 5 Msgs</span>
                    </div>
                    <div class="w-full h-2 bg-brand-subtle rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-500 w-0 transition-all duration-500 progress-bar shadow-[0_0_10px_rgba(16,185,129,0.5)]"></div>
                    </div>
                    <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                        <span class="text-brand-purple font-medium text-sm">+50 XP</span>
                        <button class="action-btn text-sm font-semibold text-white hover:text-brand-blue flex items-center gap-1 transition-colors relative z-10" onclick="event.stopPropagation()">
                            <span>Contribute</span> <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Quest 2 -->
            <div class="bento-card p-6 flex flex-col group hover:-translate-y-1 quest-card cursor-pointer" id="quest-twitter" data-id="twitter" data-current="1" data-target="1">
                <div class="flex justify-between items-start mb-6">
                    <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
                        <i data-lucide="twitter" class="w-6 h-6 text-blue-400"></i>
                    </div>
                    <div class="px-3 py-1 rounded bg-white/5 text-xs font-bold uppercase tracking-wider text-white">Weekly</div>
                </div>
                <h3 class="text-xl font-display font-bold text-white mb-2">Twitter Thread</h3>
                <p class="text-sm text-brand-muted mb-6 flex-grow">Write a 5-part thread explaining the benefits of Zero Authority's Model Context Protocol.</p>
                
                <div class="space-y-4 w-full">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-brand-muted line-clamp-1">Progress</span>
                        <span class="text-emerald-400 font-bold progress-label">1 / 1 Thread</span>
                    </div>
                    <div class="w-full h-2 bg-brand-subtle rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-500 w-full progress-bar transition-all duration-500"></div>
                    </div>
                    <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                        <span class="text-brand-purple font-medium text-sm">+250 XP</span>
                        <button class="action-btn text-sm font-semibold text-brand-muted cursor-not-allowed flex items-center gap-1 transition-colors" onclick="event.stopPropagation()">
                            Reviewing <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Quest 3 -->
            <div class="bento-card p-6 flex flex-col group hover:-translate-y-1 border-brand-blue/20 quest-card cursor-pointer" id="quest-pr" data-id="pr" data-current="0" data-target="1">
                <div class="flex justify-between items-start mb-6">
                    <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center">
                        <i data-lucide="file-code-2" class="w-6 h-6 text-brand-purple"></i>
                    </div>
                    <div class="px-3 py-1 rounded bg-brand-blue/20 text-brand-blue text-xs font-bold uppercase tracking-wider">Epic</div>
                </div>
                <h3 class="text-xl font-display font-bold text-white mb-2">First PR Merged</h3>
                <p class="text-sm text-brand-muted mb-6 flex-grow">Successfully get your first Pull Request merged into the Zero Authority core repo.</p>
                
                <div class="space-y-4 w-full">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-brand-muted line-clamp-1">Progress</span>
                        <span class="text-emerald-400 font-bold progress-label">0 / 1 PR</span>
                    </div>
                    <div class="w-full h-2 bg-brand-subtle rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-500 w-0 transition-all duration-700 progress-bar"></div>
                    </div>
                    <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                        <span class="text-emerald-400 font-bold text-sm">$100 USDC + 1000 XP</span>
                        <button class="action-btn bg-white text-black px-4 py-1.5 rounded-lg text-sm font-semibold hover:bg-gray-200 transition-all shadow-lg active:scale-95 relative z-10" onclick="event.stopPropagation()">
                            Claim
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Coming Soon Placeholder -->
            <div class="bento-card p-6 flex flex-col items-center justify-center text-center group border-dashed border-white/10 hover:border-white/20">
                <div class="w-16 h-16 rounded-full bg-brand-light flex items-center justify-center mb-4">
                    <i data-lucide="lock" class="w-6 h-6 text-brand-muted"></i>
                </div>
                <h3 class="text-lg font-display font-bold text-white mb-2">More Quests Unlocking</h3>
                <p class="text-sm text-brand-muted">Reach Level 2 to unlock governance and advanced engineering quests.</p>
            </div>
        </div>

    </main>

    <!-- Detailed Quest Modal -->
    <div id="questModal" class="fixed inset-0 modal-backdrop hidden flex items-center justify-center p-4 animate-fade-in">
        <div class="bento-card max-w-2xl w-full max-h-[90vh] overflow-y-auto bg-brand-light p-0 border-white/10 shadow-2xl animate-slide-up">
            <div class="relative p-8 md:p-10">
                <button id="closeModal" class="absolute top-6 right-6 text-brand-muted hover:text-white transition-colors bg-white/5 p-2 rounded-full">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>

                <div id="modalIconContainer" class="w-14 h-14 rounded-2xl flex items-center justify-center mb-6">
                    <i id="modalIcon" data-lucide="message-circle" class="w-8 h-8"></i>
                </div>

                <div class="mb-8">
                    <div id="modalType" class="inline-block px-3 py-1 rounded bg-white/5 text-xs font-bold uppercase tracking-wider text-white mb-3">Daily</div>
                    <h2 id="modalTitle" class="text-3xl font-display font-bold text-white mb-4">Quest Title</h2>
                    <p id="modalDescription" class="text-brand-muted leading-relaxed text-lg font-light">Quest detailed description...</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-widest text-brand-muted mb-4">Contribution Links</h4>
                        <div id="modalLinks" class="space-y-3">
                            <!-- Links injected here -->
                        </div>
                    </div>
                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-widest text-brand-muted mb-4">Requirements & Terms</h4>
                        <ul id="modalTerms" class="space-y-2 text-sm text-brand-muted list-disc ml-4">
                            <!-- Terms injected here -->
                        </ul>
                    </div>
                </div>

                <div class="pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="text-xs font-bold uppercase tracking-widest text-brand-muted">Rewards</div>
                        <div id="modalReward" class="text-brand-purple font-bold text-lg">+50 XP</div>
                    </div>
                    <button id="modalActionBtn" class="bg-white text-black px-8 py-3 rounded-xl font-bold hover:bg-gray-200 transition-all shadow-lg active:scale-95 w-full sm:w-auto">
                        Start Mission
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-white/5 py-8 mt-auto bg-brand-light/50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-brand-muted text-sm font-medium">
                <div class="w-5 h-5 rounded bg-brand-blue/20 flex items-center justify-center">
                    <i data-lucide="zap" class="w-3 h-3 text-brand-blue"></i>
                </div>
                © <%= new Date().getFullYear() %> Zero Authority DAO.
            </div>
            <div class="flex items-center gap-6 text-sm font-medium text-brand-muted">
                <a href="https://zeroauthoritydao.com/api-docs" target="_blank" class="hover:text-white transition-colors">API Specs</a>
                <a href="/mcp" class="hover:text-white transition-colors">Model Context Protocol</a>
                <a href="#" class="hover:text-white transition-colors">Terms</a>
            </div>
        </div>
    </footer>

    <script>
        // Initialize Lucide icons
        lucide.createIcons();
        
        const questData = {
            'discord': {
                title: 'Discord Engagement',
                description: 'To strengthen our community, we reward consistent participation in our Discord server. Join the #general channel, answer questions from newcomers, and share your technical insights about Model Context Protocol.',
                type: 'Daily',
                reward: '+50 XP',
                icon: 'message-circle',
                iconColor: 'text-orange-400',
                bgColor: 'bg-orange-500/10',
                links: [
                    { label: 'Join Discord', url: 'https://discord.gg/zeroauthority', icon: 'external-link' },
                    { label: 'Channel Rules', url: '#', icon: 'book-open' }
                ],
                terms: [
                    'Must be constructive and helpful',
                    'No spam or low-effort messages',
                    'Activity is verified via Discord bot',
                    'Reset every 24 hours at 00:00 UTC'
                ]
            },
            'twitter': {
                title: 'Twitter Thread',
                description: 'Help us spread the word about Zero Authority as a decentralized intelligence network. Write a high-quality thread about MCP and how it empowers developers.',
                type: 'Weekly',
                reward: '+250 XP',
                icon: 'twitter',
                iconColor: 'text-blue-400',
                bgColor: 'bg-blue-500/10',
                links: [
                    { label: 'Follow ZA on X', url: 'https://x.com/zeroauthority', icon: 'twitter' },
                    { label: 'Thread Guidelines', url: '#', icon: 'info' }
                ],
                terms: [
                    'Minimum 5 tweets in the thread',
                    'Must include @ZeroAuthority tag',
                    'Thread must be public',
                    'Submission requires verification by moderators'
                ]
            },
            'pr': {
                title: 'First PR Merged',
                description: 'The ultimate technical milestone. Contribute code back to our open-source codebase. This could be a bug fix, documentation update, or a new MCP tool implementation.',
                type: 'Epic',
                reward: '$100 USDC + 1000 XP',
                icon: 'file-code-2',
                iconColor: 'text-brand-purple',
                bgColor: 'bg-purple-500/10',
                links: [
                    { label: 'Main GitHub Repo', url: 'https://github.com/zeroauthority', icon: 'github' },
                    { label: 'Good First Issues', url: 'https://github.com/zeroauthority/issues?q=is:issue+label:good-first-issue', icon: 'layers' }
                ],
                terms: [
                    'PR must be approved and merged into main',
                    'Code must pass all CI/CD checks',
                    'Rewards distributed automatically on merge',
                    'Limited to one claim per contributor'
                ]
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            // Mobile Menu Toggle
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            if(mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                    const icon = mobileMenuBtn.querySelector('i');
                    if(mobileMenu.classList.contains('hidden')) {
                        icon.setAttribute('data-lucide', 'menu');
                    } else {
                        icon.setAttribute('data-lucide', 'x');
                    }
                    lucide.createIcons();
                });
            }

            // Modal Logic
            const modal = document.getElementById('questModal');
            const closeBtn = document.getElementById('closeModal');
            
            const openModal = (id) => {
                const data = questData[id];
                if (!data) return;

                document.getElementById('modalTitle').textContent = data.title;
                document.getElementById('modalDescription').textContent = data.description;
                document.getElementById('modalType').textContent = data.type;
                document.getElementById('modalReward').textContent = data.reward;
                
                const icon = document.getElementById('modalIcon');
                icon.setAttribute('data-lucide', data.icon);
                
                const iconContainer = document.getElementById('modalIconContainer');
                iconContainer.className = `w-14 h-14 rounded-2xl flex items-center justify-center mb-6 ${data.bgColor} ${data.iconColor} border border-white/5`;
                
                // Links
                const linksContainer = document.getElementById('modalLinks');
                linksContainer.innerHTML = data.links.map(link => `
                    <a href="${link.url}" target="_blank" class="flex items-center justify-between p-3 rounded-lg bg-white/5 border border-white/5 hover:bg-white/10 transition-colors group">
                        <span class="flex items-center gap-3 text-sm text-white">
                            <i data-lucide="${link.icon}" class="w-4 h-4 text-brand-muted"></i>
                            ${link.label}
                        </span>
                        <i data-lucide="arrow-up-right" class="w-3 h-3 text-brand-muted group-hover:text-white transition-colors"></i>
                    </a>
                `).join('');

                // Terms
                const termsContainer = document.getElementById('modalTerms');
                termsContainer.innerHTML = data.terms.map(term => `<li>${term}</li>`).join('');

                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';
                lucide.createIcons();
            };

            const closeModal = () => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.style.overflow = '';
            };

            closeBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

            document.querySelectorAll('.quest-card').forEach(card => {
                card.addEventListener('click', () => {
                    openModal(card.dataset.id);
                });
            });

            // Theme toggling
            const themeToggleBtn = document.getElementById('themeToggle');
            if(themeToggleBtn) {
                themeToggleBtn.addEventListener('click', () => {
                    const html = document.documentElement;
                    html.classList.toggle('light');
                    
                    const isLight = html.classList.contains('light');
                    themeToggleBtn.querySelector('.dark-icon').classList.toggle('hidden', !isLight);
                    themeToggleBtn.querySelector('.light-icon').classList.toggle('hidden', isLight);
                });
            }

            // Dynamic Quest Progress Logic
            const updateQuestUI = (card) => {
                const current = parseInt(card.dataset.current);
                const target = parseInt(card.dataset.target);
                const id = card.dataset.id;
                
                let unit = 'Msgs';
                if (id === 'pr') unit = 'PR';
                if (id === 'twitter') unit = 'Thread';
                
                const bar = card.querySelector('.progress-bar');
                const label = card.querySelector('.progress-label');
                const percent = Math.min((current / target) * 100, 100);
                
                if (bar) bar.style.width = `${percent}%`;
                if (label) label.textContent = `${current} / ${target} ${unit}`;
                
                if (current >= target) {
                    if (label) {
                        label.classList.remove('text-emerald-400');
                        label.classList.add('text-brand-blue');
                    }
                    const btn = card.querySelector('.action-btn');
                    if (btn && id !== 'twitter') { // Twitter is "Reviewing"
                        btn.innerHTML = `Completed <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>`;
                        btn.classList.add('text-emerald-400', 'cursor-default');
                        btn.classList.remove('hover:text-brand-blue', 'text-white', 'bg-white', 'text-black');
                        lucide.createIcons();
                    }
                }
            };

            // Initialize all quest UIs
            document.querySelectorAll('.quest-card').forEach(updateQuestUI);

            document.querySelectorAll('.action-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const card = this.closest('.quest-card');
                    if (!card) return;
                    
                    let current = parseInt(card.dataset.current);
                    const target = parseInt(card.dataset.target);
                    
                    if (current < target) {
                        current++;
                        card.dataset.current = current;
                        updateQuestUI(card);
                        
                        // Small bounce effect on click
                        this.classList.add('scale-95');
                        setTimeout(() => this.classList.remove('scale-95'), 100);
                    }
                });
            });
        });
    </script>
</body>
</html>
