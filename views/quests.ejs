<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZA Scout | Quests</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Space Grotesk', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            blue: '#0070F3',
                            purple: '#8b5cf6',
                            dark: '#000000',
                            light: '#111111',
                            subtle: '#222222',
                            text: '#EDEDED',
                            muted: '#A1A1AA'
                        }
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-out forwards',
                        'slide-up': 'slideUp 0.5s ease-out forwards',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: theme('colors.brand.dark');
            color: theme('colors.brand.text');
            -webkit-font-smoothing: antialiased;
        }
        
        .glass-panel {
            background: rgba(17, 17, 17, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        .bento-card {
            background: linear-gradient(145deg, rgba(34,34,34,0.4) 0%, rgba(17,17,17,0.8) 100%);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .bento-card:hover {
            border-color: rgba(255,255,255,0.15);
            transform: translateY(-2px);
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
        }

        .bento-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .bento-card:hover::before {
            opacity: 1;
        }

        .gradient-text {
            background: linear-gradient(to right, #fff, #a1a1aa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .glow-bg {
            position: fixed;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 800px;
            height: 400px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, rgba(0,0,0,0) 70%); /* Emerald glow for Quests page */
            pointer-events: none;
            z-index: -1;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: theme('colors.brand.dark'); }
        ::-webkit-scrollbar-thumb { background: theme('colors.brand.subtle'); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: theme('colors.brand.muted'); }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans relative">
    
    <div class="glow-bg animate-pulse-slow"></div>

    <!-- Navbar -->
    <nav class="sticky top-0 z-50 glass-panel border-b border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <a href="/" class="flex items-center gap-3 cursor-pointer">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-blue to-blue-800 flex items-center justify-center text-white shadow-[0_0_15px_rgba(0,112,243,0.4)]">
                        <i data-lucide="zap" class="w-4 h-4 text-white"></i>
                    </div>
                    <span class="font-display font-medium text-xl text-white tracking-tight">ZA Scout</span>
                </a>
                <div class="hidden md:flex items-center gap-8 bg-brand-light rounded-full px-6 py-2 border border-white/5">
                    <a href="/" class="text-brand-muted font-medium text-sm hover:text-white transition-colors">Explorer</a>
                    <a href="/quests" class="text-white font-medium text-sm transition-colors relative after:absolute after:-bottom-2 after:left-0 after:right-0 after:h-px after:bg-white after:rounded-full">Quests</a>
                    <a href="/mcp" class="text-brand-muted font-medium text-sm hover:text-white transition-colors">MCP Setup</a>
                </div>
                <div class="flex items-center gap-4">
                    <button class="text-brand-muted hover:text-white transition-colors rounded-full p-2 hover:bg-white/5">
                        <i data-lucide="bell" class="w-4 h-4"></i>
                    </button>
                    <button class="bg-white text-black hover:bg-gray-200 px-5 py-2 rounded-full text-sm font-medium transition-all shadow-[0_0_15px_rgba(255,255,255,0.2)] hover:scale-105 active:scale-95">
                        Connect
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full animate-fade-in">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div class="max-w-xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-widest mb-4">
                    <i data-lucide="crosshairs" class="w-3.5 h-3.5"></i> Active Missions
                </div>
                <h1 class="text-4xl md:text-5xl font-display font-bold gradient-text mb-4 tracking-tight">Community Quests</h1>
                <p class="text-brand-muted text-lg font-light">
                    Complete tasks, grow the community, and earn XP and rewards as a Zero Authority ambassador.
                </p>
            </div>
            
            <div class="bento-card px-6 py-4 flex items-center gap-6 self-start w-full md:w-auto">
                <div>
                    <div class="text-sm text-brand-muted font-medium mb-1">Your Rank</div>
                    <div class="font-display font-bold text-white text-xl">Scout Level 1</div>
                </div>
                <div class="w-px h-10 bg-white/10"></div>
                <div>
                    <div class="text-sm text-brand-muted font-medium mb-1">XP Earned</div>
                    <div class="font-display font-bold text-emerald-400 text-xl">0 / 500</div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-slide-up" style="animation-delay: 0.1s;">
            <!-- Quest 1 -->
            <div class="bento-card p-6 flex flex-col group hover:-translate-y-1">
                <div class="flex justify-between items-start mb-6">
                    <div class="w-12 h-12 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center">
                        <i data-lucide="message-circle" class="w-6 h-6 text-orange-400"></i>
                    </div>
                    <div class="px-3 py-1 rounded bg-white/5 text-xs font-bold uppercase tracking-wider text-white">Daily</div>
                </div>
                <h3 class="text-xl font-display font-bold text-white mb-2">Discord Engagement</h3>
                <p class="text-sm text-brand-muted mb-6 flex-grow">Participate in #general chat and help onboard new members into the DAO.</p>
                
                <div class="space-y-4 w-full">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-brand-muted line-clamp-1">Progress</span>
                        <span class="text-emerald-400 font-bold">0 / 5 Msgs</span>
                    </div>
                    <div class="w-full h-2 bg-brand-subtle rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-500 w-0"></div> <!-- Width 0 for not started -->
                    </div>
                    <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                        <span class="text-brand-purple font-medium text-sm">+50 XP</span>
                        <button class="text-sm font-semibold text-white hover:text-brand-blue flex items-center gap-1 transition-colors">
                            Start <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Quest 2 -->
            <div class="bento-card p-6 flex flex-col group hover:-translate-y-1">
                <div class="flex justify-between items-start mb-6">
                    <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
                        <i data-lucide="twitter" class="w-6 h-6 text-blue-400"></i>
                    </div>
                    <div class="px-3 py-1 rounded bg-white/5 text-xs font-bold uppercase tracking-wider text-white">Weekly</div>
                </div>
                <h3 class="text-xl font-display font-bold text-white mb-2">Twitter Thread</h3>
                <p class="text-sm text-brand-muted mb-6 flex-grow">Write a 5-part thread explaining the benefits of Zero Authority's Model Context Protocol.</p>
                
                <div class="space-y-4 w-full">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-brand-muted line-clamp-1">Progress</span>
                        <span class="text-emerald-400 font-bold">1 / 1 Thread</span>
                    </div>
                    <div class="w-full h-2 bg-brand-subtle rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-500 w-full opacity-50"></div>
                    </div>
                    <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                        <span class="text-brand-purple font-medium text-sm">+250 XP</span>
                        <button class="text-sm font-semibold text-white hover:text-brand-blue flex items-center gap-1 transition-colors">
                            Reviewing <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Quest 3 -->
            <div class="bento-card p-6 flex flex-col group hover:-translate-y-1 border-brand-blue/20">
                <div class="flex justify-between items-start mb-6">
                    <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center">
                        <i data-lucide="file-code-2" class="w-6 h-6 text-brand-purple"></i>
                    </div>
                    <div class="px-3 py-1 rounded bg-brand-blue/20 text-brand-blue text-xs font-bold uppercase tracking-wider">Epic</div>
                </div>
                <h3 class="text-xl font-display font-bold text-white mb-2">First PR Merged</h3>
                <p class="text-sm text-brand-muted mb-6 flex-grow">Successfully get your first Pull Request merged into the Zero Authority core repo.</p>
                
                <div class="space-y-4 w-full">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-brand-muted line-clamp-1">Progress</span>
                        <span class="text-emerald-400 font-bold">0 / 1 PR</span>
                    </div>
                    <div class="w-full h-2 bg-brand-subtle rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-500 w-0"></div>
                    </div>
                    <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                        <span class="text-emerald-400 font-bold text-sm">$100 USDC + 1000 XP</span>
                        <button class="bg-white text-black px-4 py-1.5 rounded-lg text-sm font-semibold hover:bg-gray-200 transition-colors">
                            Claim
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Coming Soon Placeholder -->
            <div class="bento-card p-6 flex flex-col items-center justify-center text-center group border-dashed border-white/10 hover:border-white/20">
                <div class="w-16 h-16 rounded-full bg-brand-light flex items-center justify-center mb-4">
                    <i data-lucide="lock" class="w-6 h-6 text-brand-muted"></i>
                </div>
                <h3 class="text-lg font-display font-bold text-white mb-2">More Quests Unlocking</h3>
                <p class="text-sm text-brand-muted">Reach Level 2 to unlock governance and advanced engineering quests.</p>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-white/5 py-8 mt-auto bg-brand-light/50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-brand-muted text-sm font-medium">
                <div class="w-5 h-5 rounded bg-brand-blue/20 flex items-center justify-center">
                    <i data-lucide="zap" class="w-3 h-3 text-brand-blue"></i>
                </div>
                © <%= new Date().getFullYear() %> Zero Authority DAO.
            </div>
            <div class="flex items-center gap-6 text-sm font-medium text-brand-muted">
                <a href="https://zeroauthoritydao.com/api-docs" target="_blank" class="hover:text-white transition-colors">API Specs</a>
                <a href="/mcp" class="hover:text-white transition-colors">Model Context Protocol</a>
                <a href="#" class="hover:text-white transition-colors">Terms</a>
            </div>
        </div>
    </footer>

    <script>
        // Initialize Lucide icons
        lucide.createIcons();
    </script>
</body>
</html>
