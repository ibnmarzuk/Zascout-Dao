<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <%- include('partials/head', { title: 'Bounties Explorer' }) %>
</head>
<body class="min-h-screen flex font-sans text-brand-text bg-brand-dark relative overflow-x-hidden">
    
    <%- include('partials/sidebar', { activePage: 'bounties' }) %>

    <div class="flex-grow flex flex-col min-w-0">
        <%- include('partials/topbar') %>

        <main class="flex-grow p-4 sm:p-6 lg:p-10 w-full animate-fade-in lg:ml-64 max-w-7xl mx-auto">
            
            <!-- Header section -->
            <div class="mb-10 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
                <div>
                    <h1 class="text-3xl lg:text-4xl font-display font-bold text-white mb-2 tracking-tight">Bounties Explorer</h1>
                    <p class="text-brand-muted text-base max-w-xl">Find open technical challenges, bugs, and specific tasks across DAOs. Filter by ecosystem and reward size.</p>
                </div>
                
                <div class="flex flex-col sm:flex-row gap-3">
                    <div class="relative w-full sm:w-64 group">
                        <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-muted group-focus-within:text-brand-blue transition-colors"></i>
                        <input type="text" placeholder="Search bounties..." class="w-full bg-black/20 border border-white/5 rounded-lg pl-10 pr-4 py-2 text-sm text-white focus:outline-none focus:border-brand-blue/50 focus:ring-2 focus:ring-brand-blue/20 transition-all">
                    </div>
                    <button class="bg-white/5 border border-white/5 hover:bg-white/10 text-white rounded-lg px-4 py-2 text-sm font-medium transition-all flex items-center justify-center gap-2">
                        <i data-lucide="filter" class="w-4 h-4"></i> Filter
                    </button>
                </div>
            </div>

            <!-- Trending Bounties -->
            <div class="mb-12">
                <div class="flex items-center gap-2 mb-4 px-2 text-brand-purple">
                    <i data-lucide="flame" class="w-5 h-5"></i>
                    <h2 class="font-display font-bold text-lg text-white">Trending Bounties</h2>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <!-- Card 1 -->
                    <div class="bento-card p-5 group flex flex-col cursor-pointer border-brand-purple/20 relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-24 h-24 bg-brand-purple/10 blur-2xl -mr-10 -mt-10 rounded-full"></div>
                        <div class="flex justify-between items-start mb-4 relative">
                            <div class="w-10 h-10 rounded bg-white/5 border border-white/10 flex items-center justify-center">
                                <i data-lucide="code-2" class="w-5 h-5 text-brand-muted"></i>
                            </div>
                            <div class="text-right">
                                <div class="font-display font-bold text-lg text-brand-purple">$1,200 <span class="text-xs text-brand-muted font-sans font-medium">USDC</span></div>
                            </div>
                        </div>
                        <h3 class="text-base font-semibold text-white mb-2 group-hover:text-brand-purple transition-colors line-clamp-2">Develop MCP Submorphic Plugin</h3>
                        <div class="text-sm text-brand-muted mb-4">Zero Authority DAO</div>
                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                            <div class="flex items-center gap-1.5 text-xs font-medium text-orange-400">
                                <i data-lucide="clock" class="w-3.5 h-3.5"></i> 2 days left
                            </div>
                            <div class="flex gap-1.5">
                                <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-brand-purple/10 text-brand-purple rounded">Typescript</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Card 2 -->
                    <div class="bento-card p-5 group flex flex-col cursor-pointer relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-24 h-24 bg-brand-blue/10 blur-2xl -mr-10 -mt-10 rounded-full"></div>
                        <div class="flex justify-between items-start mb-4 relative">
                            <div class="w-10 h-10 rounded bg-white/5 border border-white/10 flex items-center justify-center">
                                <i data-lucide="bug" class="w-5 h-5 text-brand-muted"></i>
                            </div>
                            <div class="text-right">
                                <div class="font-display font-bold text-lg text-white">$500 <span class="text-xs text-brand-muted font-sans font-medium">USDC</span></div>
                            </div>
                        </div>
                        <h3 class="text-base font-semibold text-white mb-2 group-hover:text-brand-blue transition-colors line-clamp-2">Smart Contract Vault Audit</h3>
                        <div class="text-sm text-brand-muted mb-4">Compound DAO</div>
                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                            <div class="flex items-center gap-1.5 text-xs font-medium text-brand-muted">
                                <i data-lucide="calendar" class="w-3.5 h-3.5"></i> 14 days left
                            </div>
                            <div class="flex gap-1.5">
                                <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-brand-blue/10 text-brand-blue rounded">Solidity</span>
                            </div>
                        </div>
                    </div>

                    <!-- Card 3 -->
                    <div class="bento-card p-5 group flex flex-col cursor-pointer relative overflow-hidden hidden md:flex">
                        <div class="flex justify-between items-start mb-4 relative">
                            <div class="w-10 h-10 rounded bg-white/5 border border-white/10 flex items-center justify-center">
                                <i data-lucide="pen-tool" class="w-5 h-5 text-brand-muted"></i>
                            </div>
                            <div class="text-right">
                                <div class="font-display font-bold text-lg text-white">$300 <span class="text-xs text-brand-muted font-sans font-medium">USDC</span></div>
                            </div>
                        </div>
                        <h3 class="text-base font-semibold text-white mb-2 group-hover:text-white transition-colors line-clamp-2">Design UI Kit for Governance</h3>
                        <div class="text-sm text-brand-muted mb-4">ENS DAO</div>
                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                            <div class="flex items-center gap-1.5 text-xs font-medium text-brand-muted">
                                <i data-lucide="calendar" class="w-3.5 h-3.5"></i> 5 days left
                            </div>
                            <div class="flex gap-1.5">
                                <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-white/10 text-white rounded">Design</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- All Bounties List -->
            <div>
                <div class="flex items-center justify-between px-2 mb-4 border-b border-white/5 pb-4">
                    <h2 class="font-display font-bold text-lg text-white">All Bounties</h2>
                    <!-- Mini Filters -->
                    <div class="hidden sm:flex gap-4">
                        <button class="text-xs font-bold uppercase tracking-wider text-white border-b-2 border-brand-blue pb-1">Latest</button>
                        <button class="text-xs font-bold uppercase tracking-wider text-brand-muted hover:text-white pb-1 transition-colors">Highest Value</button>
                        <button class="text-xs font-bold uppercase tracking-wider text-brand-muted hover:text-white pb-1 transition-colors">Ending Soon</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-3">
                    <% const mockBounties = [
                        { title: 'Write tests for Core Protocol', dao: 'Aave', reward: 150, time: '7 days', tag: 'Testing', color: 'blue' },
                        { title: 'Update documentation for V3', dao: 'Optimism', reward: 100, time: '3 days', tag: 'Content', color: 'gray' },
                        { title: 'Fix CSS bug in modal component', dao: 'ZA Scout', reward: 50, time: '2 days', tag: 'Frontend', color: 'purple' },
                        { title: 'Create tutorial video', dao: 'Arbitrum', reward: 250, time: '10 days', tag: 'Media', color: 'orange' },
                        { title: 'Translate wiki to Spanish', dao: 'ENS', reward: 120, time: '5 days', tag: 'Translation', color: 'gray' }
                    ]; %>

                    <% mockBounties.forEach(function(b) { %>
                        <div class="bento-card p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 group cursor-pointer hover:bg-white/[0.02]">
                            <div class="flex items-start gap-4 flex-grow">
                                <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 items-center justify-center shrink-0 hidden sm:flex">
                                    <i data-lucide="target" class="w-4 h-4 text-brand-muted group-hover:text-<%= b.color %>-400 transition-colors"></i>
                                </div>
                                <div>
                                    <h3 class="text-base font-semibold text-white group-hover:text-brand-blue transition-colors"><%= b.title %></h3>
                                    <div class="flex flex-wrap items-center gap-3 mt-1.5">
                                        <span class="text-sm text-brand-muted"><%= b.dao %></span>
                                        <span class="w-1 h-1 rounded-full bg-white/10"></span>
                                        <span class="text-xs font-medium text-brand-muted flex items-center gap-1">
                                            <i data-lucide="clock" class="w-3 h-3"></i> <%= b.time %> left
                                        </span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto mt-2 sm:mt-0 pt-3 sm:pt-0 border-t border-white/5 sm:border-t-0">
                                <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-white/5 text-gray-400 rounded"><%= b.tag %></span>
                                <div class="font-display font-bold text-lg text-white w-24 text-right">
                                    $<%= b.reward %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <div class="mt-8 flex justify-center">
                    <button class="text-sm font-medium text-brand-muted hover:text-white px-4 py-2 border border-white/10 rounded-lg hover:bg-white/5 transition-all">Load More</button>
                </div>
            </div>

        </main>
    </div>

    <%- include('partials/footer_scripts') %>
</body>
</html>