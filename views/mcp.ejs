<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <%- include('partials/head', { title: 'MCP Setup' }) %>
    <style>
        .code-block { 
            background-color: rgba(0, 0, 0, 0.5); 
            border: 1px solid rgba(255,255,255,0.1); 
            border-radius: 12px;
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.2);
        }
        pre, code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        }
    </style>
</head>
<body class="min-h-screen flex font-sans text-brand-text bg-brand-dark relative overflow-x-hidden">
    
    <%- include('partials/sidebar', { activePage: 'mcp' }) %>

    <div class="flex-grow flex flex-col min-w-0 lg:pl-64">
        <%- include('partials/topbar') %>

        <main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full animate-fade-in">
            
            <div class="mb-10 text-center max-w-2xl mx-auto">
                <div class="inline-flex items-center justify-center gap-2 px-3 py-1 rounded-full bg-brand-purple/10 border border-brand-purple/20 text-brand-purple text-xs font-semibold uppercase tracking-widest mb-6">
                    <i data-lucide="blocks" class="w-3.5 h-3.5"></i> Model Context Protocol
                </div>
                <h1 class="text-4xl md:text-5xl font-display font-bold text-white mb-4 tracking-tight">Connect Your AI</h1>
                <p class="text-brand-muted text-lg font-light">
                    Securely link Claude Desktop, Cursor, or Claude Code directly to the ZA Scout network using MCP to search opportunities seamlessly. 
                </p>
            </div>

            <div class="bento-card p-8 md:p-10 mb-8 border-t relative" style="border-top-color: theme('colors.brand.purple');">
                
                <div class="absolute top-0 right-0 w-64 h-64 bg-brand-purple/10 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/4 pointer-events-none"></div>

                <div class="relative z-10 space-y-10">
                    <!-- Step 1 -->
                    <div>
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 rounded-full bg-brand-purple/20 text-brand-purple flex items-center justify-center font-display font-bold text-sm">1</div>
                            <h3 class="text-xl font-display font-bold text-white">Generate your API Key</h3>
                        </div>
                        <div class="ml-11">
                            <p class="text-brand-muted mb-4">You need an active API Key to authenticate the MCP client and access DAO data.</p>
                            <button class="bg-brand-purple text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-purple-600 transition-all shadow-[0_0_15px_rgba(139,92,246,0.3)] hover:shadow-[0_0_20px_rgba(139,92,246,0.5)] flex items-center gap-2">
                                <i data-lucide="key" class="w-4 h-4"></i> Generate Access Key
                            </button>
                        </div>
                    </div>
                    
                    <div class="h-px bg-white/5 w-full ml-11 max-w-2xl"></div>
                    
                    <!-- Step 2 -->
                    <div>
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 rounded-full bg-brand-purple/20 text-brand-purple flex items-center justify-center font-display font-bold text-sm">2</div>
                            <h3 class="text-xl font-display font-bold text-white">Add to Claude Desktop</h3>
                        </div>
                        <div class="ml-11">
                            <p class="text-brand-muted mb-4">Add the following JSON configuration to your <code>claude_desktop_config.json</code> file to initialize the server:</p>
                            <div class="code-block p-5 overflow-x-auto relative group">
                                <pre class="text-sm text-green-400"><code>{
  "mcpServers": {
    "zero-authority": {
      "command": "npx",
      "args": ["-y", "@zeroauthority/mcp-server"],
      "env": {
        "ZA_API_KEY": "YOUR_ZA_API_KEY"
      }
    }
  }
}</code></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 animate-slide-up" style="animation-delay: 0.1s;">
                <!-- Available Tools -->
                <div class="bento-card p-6 md:p-8 flex flex-col h-full hover:border-white/20 transition-all">
                    <div class="w-10 h-10 rounded-full bg-brand-blue/10 flex items-center justify-center mb-5">
                        <i data-lucide="wrench" class="w-5 h-5 text-brand-blue"></i>
                    </div>
                    <h3 class="text-lg font-display font-bold text-white mb-4">Available Capabilities</h3>
                    <ul class="space-y-4 text-sm text-brand-muted flex-grow">
                        <li class="flex items-start gap-3">
                            <i data-lucide="check" class="w-4 h-4 text-emerald-400 mt-1 shrink-0"></i>
                            <span><strong class="text-white">get_bounties</strong>: Search for open gigs and bounties by keyword and tags.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i data-lucide="check" class="w-4 h-4 text-emerald-400 mt-1 shrink-0"></i>
                            <span><strong class="text-white">get_quests</strong>: Find community quests and ambassador tasks.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i data-lucide="check" class="w-4 h-4 text-emerald-400 mt-1 shrink-0"></i>
                            <span><strong class="text-white">apply_to_bounty</strong>: Draft an application directly from AI.</span>
                        </li>
                    </ul>
                </div>
                
                <!-- CLI Integration -->
                <div class="bento-card p-6 md:p-8 flex flex-col h-full hover:border-white/20 transition-all relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/5 to-transparent z-0"></div>
                    <div class="relative z-10 w-full h-full flex flex-col">
                        <div class="w-10 h-10 rounded-full bg-brand-light border border-white/5 flex items-center justify-center mb-5 flex-shrink-0">
                            <i data-lucide="terminal" class="w-5 h-5 text-white"></i>
                        </div>
                        <h3 class="text-lg font-display font-bold text-white mb-2">Try it with Claude Code</h3>
                        <p class="text-sm text-brand-muted mb-5 leading-relaxed">Run this in your terminal to empower your CLI agent with DAO intelligence.</p>
                        
                        <div class="code-block p-4 overflow-x-auto text-sm text-gray-300 mt-auto relative">
                            <div class="flex items-center gap-2 mb-1 opacity-70">
                                <span class="text-emerald-400">$</span> <code>export ZA_API_KEY=YOUR_KEY</code>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="text-emerald-400">$</span> <code class="whitespace-nowrap">claude mcp add zero-authority npx -y @zero-authority/mcp</code>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </main>
    </div>

    <%- include('partials/footer_scripts') %>
</body>
</html>