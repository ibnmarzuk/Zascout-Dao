<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <%- include('partials/head', { title: 'Gigs' }) %>
</head>
<body class="min-h-screen flex font-sans text-brand-text bg-brand-dark relative overflow-x-hidden">
    
    <%- include('partials/sidebar', { activePage: 'gigs' }) %>

    <div class="flex-grow flex flex-col min-w-0 lg:pl-64">
        <%- include('partials/topbar') %>

        <main class="flex-grow p-4 sm:p-6 lg:p-10 w-full animate-fade-in max-w-7xl mx-auto">
            
            <div class="mb-10 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
                <div>
                    <h1 class="text-3xl lg:text-4xl font-display font-bold text-white mb-2 tracking-tight">Freelance Gigs</h1>
                    <p class="text-brand-muted text-base max-w-xl">Find short and long term freelance opportunities across Web3 projects. Work remotely, get paid in crypto.</p>
                </div>
            </div>

            <!-- Gigs Filter Bar -->
            <div class="bento-card p-4 mb-8 flex flex-col lg:flex-row gap-4 lg:items-center">
                <div class="relative w-full lg:w-64">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-muted"></i>
                    <input type="text" placeholder="Search gigs..." class="w-full bg-black/20 border border-white/5 rounded-lg pl-9 pr-3 py-2 text-sm text-white focus:outline-none focus:border-brand-blue/50">
                </div>
                
                <div class="flex flex-wrap gap-2 lg:ml-auto">
                    <select class="bg-black/20 border border-white/5 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-blue/50 appearance-none min-w-[120px]">
                        <option value="">Any Skill</option>
                        <option value="frontend">Frontend</option>
                        <option value="backend">Backend</option>
                        <option value="smart-contracts">Smart Contracts</option>
                        <option value="design">Design</option>
                    </select>
                    
                    <select class="bg-black/20 border border-white/5 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-blue/50 appearance-none min-w-[120px]">
                        <option value="">Any Category</option>
                        <option value="engineering">Engineering</option>
                        <option value="marketing">Marketing</option>
                        <option value="community">Community</option>
                    </select>

                    <label class="flex items-center gap-2 text-sm text-brand-muted whitespace-nowrap bg-black/20 border border-white/5 rounded-lg px-3 py-2 cursor-pointer hover:text-white transition-colors">
                        <input type="checkbox" class="rounded accent-brand-purple"> Remote Only
                    </label>

                    <label class="flex items-center gap-2 text-sm text-brand-muted whitespace-nowrap bg-black/20 border border-white/5 rounded-lg px-3 py-2 cursor-pointer hover:text-white transition-colors">
                        <input type="checkbox" class="rounded accent-brand-purple"> Beginner Friendly
                    </label>
                </div>
            </div>

            <!-- Gigs Grid -->
            <div id="gigsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- Hydrated via JS -->
            </div>

            <!-- Empty State -->
            <div id="gigsEmpty" class="bento-card p-12 flex flex-col items-center justify-center text-center hidden">
                <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center mb-4">
                    <i data-lucide="briefcase" class="w-6 h-6 text-brand-muted"></i>
                </div>
                <span class="text-brand-text font-bold text-base">No gigs found</span>
            </div>

        </main>
    </div>

    <%- include('partials/footer_scripts') %>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            loadGigs();
        });

        async function loadGigs() {
            try {
                const response = await fetch('/api/gigs/fetched?limit=20');
                const result = await response.json();
                
                const grid = document.getElementById('gigsGrid');
                const empty = document.getElementById('gigsEmpty');
                
                if (result.success && result.data && result.data.length > 0) {
                    grid.innerHTML = '';
                    result.data.forEach((gig, index) => {
                        const gigId = gig.id || 'gig-' + index;
                        const title = gig.title || gig.name || 'Freelance Gig';
                        const daoName = gig.campaign?.name || gig.creator?.username || 'ZA Project';
                        const reward = gig.totalRep ? gig.totalRep + ' REP' : (gig.reward || 'TBD');
                        
                        grid.innerHTML += `
                            <div class="bento-card p-6 flex flex-col group hover:border-brand-purple/30 transition-all cursor-pointer relative" onclick="openGlobalBountyDetail('${gigId}')">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center shrink-0">
                                            <i data-lucide="briefcase" class="w-5 h-5 text-brand-muted"></i>
                                        </div>
                                        <div>
                                            <h3 class="text-base font-bold text-white group-hover:text-brand-purple transition-colors leading-snug">${title}</h3>
                                            <div class="text-sm text-brand-muted">${daoName}</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1 mb-5 text-xs text-brand-muted">
                                    <i data-lucide="coins" class="w-3.5 h-3.5"></i>
                                    <span class="font-bold text-white">${reward}</span>
                                </div>
                                <div class="text-[12px] text-brand-muted line-clamp-2 group-hover:line-clamp-none transition-all duration-300 mb-4">${gig.description || 'No description provided.'}</div>
                                <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                                    <button class="bg-brand-blue hover:bg-blue-600 text-white px-5 py-2 rounded-lg text-sm font-semibold transition-all active:scale-[0.98]">Apply Now</button>
                                </div>
                            </div>
                        `;
                    });
                    lucide.createIcons();
                } else {
                    grid.classList.add('hidden');
                    empty.classList.remove('hidden');
                }
            } catch (err) {
                console.error("Gigs api error", err);
            }
        }
    </script>
</body>
</html>