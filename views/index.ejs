<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZA Scout | Zero Authority DAO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Space Grotesk', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            blue: '#3b82f6',
                            purple: '#8b5cf6',
                            dark: '#0f1115',
                            light: '#1e2128'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: theme('colors.brand.dark');
            color: #d1d5db; /* gray-300 */
        }
        .glass-panel {
            background: rgba(30, 33, 40, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans">
    
    <!-- Navbar -->
    <nav class="sticky top-0 z-50 glass-panel border-b border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded bg-brand-blue flex items-center justify-center text-white">
                        <i data-lucide="zap" class="w-4 h-4"></i>
                    </div>
                    <span class="font-display font-bold text-xl text-white tracking-tight italic">ZA Scout</span>
                </div>
                <div class="hidden md:flex items-center gap-6">
                    <a href="/" class="text-white font-medium text-sm hover:text-brand-blue transition-colors">Explorer</a>
                    <a href="/quests" class="text-gray-400 font-medium text-sm hover:text-white transition-colors">Quests</a>
                    <a href="/mcp" class="text-gray-400 font-medium text-sm hover:text-white transition-colors">MCP Guide</a>
                </div>
                <div class="flex items-center gap-4">
                    <button class="text-gray-400 hover:text-white transition-colors">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                    </button>
                    <button class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-white/5">
                        Connect Wallet
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-3xl font-display font-bold text-white mb-2">Zero Authority Explorer</h1>
                <p class="text-gray-400 text-sm">Discover and contribute to Bounties, Gigs, and Grants.</p>
            </div>
            
            <!-- Global Search & Filter -->
            <div class="flex items-center gap-3 w-full md:w-auto">
                <div class="relative w-full md:w-64">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"></i>
                    <input type="text" placeholder="Search opportunities..." class="w-full bg-brand-light border border-white/10 rounded-lg pl-9 pr-4 py-2 text-sm text-white focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-all">
                </div>
                <button class="bg-brand-light border border-white/10 p-2 rounded-lg text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="sliders-horizontal" class="w-5 h-5"></i>
                </button>
            </div>
        </div>

        <!-- Dashboard Widgets -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <div class="glass-panel p-6 rounded-xl">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-gray-400 font-medium text-sm">Total Value Listed</h3>
                    <i data-lucide="dollar-sign" class="w-4 h-4 text-brand-blue"></i>
                </div>
                <div class="text-3xl font-display font-bold text-white">$45,200</div>
                <div class="text-xs text-emerald-400 mt-2 flex items-center gap-1">
                    <i data-lucide="trending-up" class="w-3 h-3"></i> +12% this week
                </div>
            </div>
            <div class="glass-panel p-6 rounded-xl">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-gray-400 font-medium text-sm">Active Bounties</h3>
                    <i data-lucide="target" class="w-4 h-4 text-brand-purple"></i>
                </div>
                <div class="text-3xl font-display font-bold text-white"><%= opportunities.length %></div>
                <div class="text-xs text-gray-400 mt-2 flex items-center gap-1">
                    Powered by ZA API
                </div>
            </div>
            <div class="glass-panel p-6 rounded-xl relative overflow-hidden group cursor-pointer border-brand-purple/30 hover:border-brand-purple/60 transition-colors">
                <div class="absolute inset-0 bg-gradient-to-br from-brand-purple/10 to-transparent opacity-50 group-hover:opacity-100 transition-opacity"></div>
                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-brand-purple font-medium text-sm flex items-center gap-2">
                            <i data-lucide="bot" class="w-4 h-4"></i> AI Agent Ready
                        </h3>
                    </div>
                    <div class="text-lg font-display font-bold text-white mb-1">MCP Integration</div>
                    <p class="text-xs text-gray-400">Connect Cursor or Claude directly to the DAO</p>
                </div>
                <i data-lucide="arrow-up-right" class="absolute bottom-4 right-4 w-4 h-4 text-brand-purple opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all"></i>
            </div>
        </div>

        <!-- Tabs -->
        <div class="flex items-center gap-6 border-b border-white/10 mb-6">
            <button class="pb-3 text-sm font-medium text-white border-b-2 border-brand-blue">All Opportunities</button>
            <button class="pb-3 text-sm font-medium text-gray-400 hover:text-white transition-colors">Bounties</button>
            <button class="pb-3 text-sm font-medium text-gray-400 hover:text-white transition-colors">Grants</button>
            <button class="pb-3 text-sm font-medium text-gray-400 hover:text-white transition-colors">Quests</button>
        </div>

        <!-- Opportunities Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <% if (opportunities && opportunities.length > 0) { %>
                <% opportunities.forEach(function(op) { %>
                    <div class="glass-panel p-5 rounded-xl hover:bg-white/[0.03] transition-all cursor-pointer flex flex-col md:flex-row gap-5 items-start">
                        <div class="flex-grow">
                            <div class="flex items-center justify-between mb-2">
                                <span class="bg-brand-blue/10 text-brand-blue text-xs font-bold uppercase tracking-wider px-2 py-1 rounded">
                                    <%= op.type %>
                                </span>
                                <span class="text-sm font-display text-emerald-400 font-medium">
                                    $<%= op.reward.toLocaleString() %>
                                </span>
                            </div>
                            <h3 class="text-lg font-bold text-white mb-2 leading-tight"><%= op.title %></h3>
                            <div class="flex flex-wrap items-center gap-2 mb-4">
                                <span class="text-xs text-gray-400 flex items-center gap-1">
                                    <i data-lucide="building-2" class="w-3 h-3"></i> <%= op.dao %>
                                </span>
                                <span class="text-gray-600 text-xs">•</span>
                                <span class="text-xs text-gray-400 flex items-center gap-1">
                                    <i data-lucide="clock" class="w-3 h-3"></i> <%= op.status %>
                                </span>
                            </div>
                            
                            <!-- Tags -->
                            <div class="flex flex-wrap gap-2">
                                <% if (op.tags && op.tags.length > 0) { %>
                                    <% op.tags.forEach(function(tag) { %>
                                        <span class="text-[11px] font-medium px-2 py-1 bg-white/5 text-gray-300 rounded"><%= tag %></span>
                                    <% }); %>
                                <% } %>
                            </div>
                        </div>
                        <div class="w-full md:w-auto mt-4 md:mt-0 flex justify-end">
                            <button class="w-full md:w-auto bg-white text-black font-medium text-sm px-4 py-2 rounded-lg hover:bg-gray-200 transition-colors">
                                Apply Now
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full py-12 text-center text-gray-400">
                    <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-4 opacity-50"></i>
                    <p>No opportunities found.</p>
                </div>
            <% } %>
        </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-white/5 py-8 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-gray-400 text-sm">
                <i data-lucide="zap" class="w-4 h-4"></i>
                © <%= new Date().getFullYear() %> Zero Authority DAO. All rights reserved.
            </div>
            <div class="flex items-center gap-4 text-sm text-gray-500">
                <a href="#" class="hover:text-white transition-colors">API Docs</a>
                <a href="#" class="hover:text-white transition-colors">MCP Spec</a>
                <a href="#" class="hover:text-white transition-colors">Terms</a>
            </div>
        </div>
    </footer>

    <script>
        // Initialize Lucide icons
        lucide.createIcons();
    </script>
</body>
</html>
