<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZA Scout | Zero Authority DAO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Space Grotesk', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            blue: '#0070F3',
                            purple: '#8b5cf6',
                            dark: '#000000',
                            light: '#111111',
                            subtle: '#222222',
                            text: '#EDEDED',
                            muted: '#A1A1AA'
                        }
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-out forwards',
                        'slide-up': 'slideUp 0.5s ease-out forwards',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: theme('colors.brand.dark');
            color: theme('colors.brand.text');
            -webkit-font-smoothing: antialiased;
        }
        
        .glass-panel {
            background: rgba(17, 17, 17, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        .bento-card {
            background: linear-gradient(145deg, rgba(34,34,34,0.4) 0%, rgba(17,17,17,0.8) 100%);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .bento-card:hover {
            border-color: rgba(255,255,255,0.15);
            transform: translateY(-2px);
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
        }

        .bento-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .bento-card:hover::before {
            opacity: 1;
        }

        .gradient-text {
            background: linear-gradient(to right, #fff, #a1a1aa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .glow-bg {
            position: fixed;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 800px;
            height: 400px;
            background: radial-gradient(circle, rgba(0, 112, 243, 0.15) 0%, rgba(0,0,0,0) 70%);
            pointer-events: none;
            z-index: -1;
        }

        .tab-btn {
            position: relative;
        }
        .tab-btn.active {
            color: white;
        }
        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background-color: theme('colors.brand.blue');
            border-radius: 2px 2px 0 0;
            box-shadow: 0 0 8px theme('colors.brand.blue');
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: theme('colors.brand.dark');
        }
        ::-webkit-scrollbar-thumb {
            background: theme('colors.brand.subtle');
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: theme('colors.brand.muted');
        }
        
        .opportunity-card.hidden {
            display: none !important;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans relative">
    
    <div class="glow-bg animate-pulse-slow"></div>

    <!-- Navbar -->
    <nav class="sticky top-0 z-50 glass-panel border-b border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-3 cursor-pointer">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-blue to-blue-800 flex items-center justify-center text-white shadow-[0_0_15px_rgba(0,112,243,0.4)]">
                        <i data-lucide="zap" class="w-4 h-4 text-white"></i>
                    </div>
                    <span class="font-display font-medium text-xl text-white tracking-tight">ZA Scout</span>
                </div>
                <div class="hidden md:flex items-center gap-8 bg-brand-light rounded-full px-6 py-2 border border-white/5">
                    <a href="/" class="text-white font-medium text-sm transition-colors relative after:absolute after:-bottom-2 after:left-0 after:right-0 after:h-px after:bg-white after:rounded-full">Explorer</a>
                    <a href="/quests" class="text-brand-muted font-medium text-sm hover:text-white transition-colors">Quests</a>
                    <a href="/mcp" class="text-brand-muted font-medium text-sm hover:text-white transition-colors">MCP Setup</a>
                </div>
                <div class="flex items-center gap-4">
                    <button class="text-brand-muted hover:text-white transition-colors rounded-full p-2 hover:bg-white/5">
                        <i data-lucide="bell" class="w-4 h-4"></i>
                    </button>
                    <button class="bg-white text-black hover:bg-gray-200 px-5 py-2 rounded-full text-sm font-medium transition-all shadow-[0_0_15px_rgba(255,255,255,0.2)] hover:scale-105 active:scale-95">
                        Connect
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full animate-fade-in">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-blue/10 border border-brand-blue/20 text-brand-blue text-xs font-semibold uppercase tracking-widest mb-4">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-blue opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-blue"></span>
                    </span>
                    Live V1 API Data
                </div>
                <h1 class="text-4xl md:text-5xl font-display font-bold gradient-text mb-4 tracking-tight">Explore the DAO Ecosystem</h1>
                <p class="text-brand-muted text-lg font-light">Discover high-impact bounties, grants, and quests across the Zero Authority network. Filter, find, and contribute.</p>
            </div>
            
            <!-- Global Search -->
            <div class="w-full md:w-80 group">
                <div class="relative">
                    <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-muted group-focus-within:text-brand-blue transition-colors"></i>
                    <input type="text" id="searchInput" placeholder="Search by title, tag, DAO..." class="w-full bg-brand-light border border-white/10 rounded-xl pl-11 pr-4 py-3 text-sm text-white placeholder:text-brand-muted focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all shadow-inner">
                </div>
            </div>
        </div>

        <!-- Dashboard Bento Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-5 mb-14 animate-slide-up" style="animation-delay: 0.1s;">
            <!-- Main Stat -->
            <div class="md:col-span-4 bento-card p-6 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-8">
                    <div class="w-10 h-10 rounded-full bg-brand-light border border-white/5 flex items-center justify-center">
                        <i data-lucide="bar-chart-3" class="w-5 h-5 text-brand-blue"></i>
                    </div>
                    <span class="px-2.5 py-1 rounded-full bg-green-500/10 text-green-400 text-xs font-medium border border-green-500/20">+15.2%</span>
                </div>
                <div>
                    <h3 class="text-brand-muted text-sm font-medium mb-1">Total Value Locked</h3>
                    <div class="text-4xl font-display font-bold text-white">$45,200<span class="text-brand-muted text-lg">.00</span></div>
                </div>
            </div>

            <!-- Active Bounties -->
            <div class="md:col-span-3 bento-card p-6 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-8">
                    <div class="w-10 h-10 rounded-full bg-brand-light border border-white/5 flex items-center justify-center">
                        <i data-lucide="target" class="w-5 h-5 text-orange-400"></i>
                    </div>
                </div>
                <div>
                    <h3 class="text-brand-muted text-sm font-medium mb-1">Open Opportunities</h3>
                    <div class="text-4xl font-display font-bold text-white"><%= opportunities.length %></div>
                </div>
            </div>

            <!-- AI Promo -->
            <div class="md:col-span-5 bento-card p-6 relative overflow-hidden group cursor-pointer border-brand-purple/20 hover:border-brand-purple/50">
                <div class="absolute inset-0 bg-gradient-to-r from-brand-purple/5 to-transparent opacity-50 group-hover:opacity-100 transition-opacity"></div>
                
                <div class="absolute top-0 right-0 w-32 h-32 bg-brand-purple/20 rounded-full blur-[50px] -translate-y-1/2 translate-x-1/4 group-hover:bg-brand-purple/30 transition-all"></div>

                <div class="relative z-10 flex flex-col h-full justify-between">
                    <div class="flex justify-between items-start">
                        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-brand-purple/10 text-brand-purple text-xs font-medium">
                            <i data-lucide="sparkles" class="w-3 h-3"></i> AI Powered
                        </div>
                        <div class="w-8 h-8 rounded-full bg-brand-light flex items-center justify-center opacity-0 -translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all">
                            <i data-lucide="arrow-right" class="w-4 h-4 text-white"></i>
                        </div>
                    </div>
                    
                    <div class="mt-6">
                        <h3 class="text-xl font-display font-bold text-white mb-2">MCP Integration Available</h3>
                        <p class="text-sm text-brand-muted max-w-sm">Connect Cursor or Claude directly to the Zero Authority network to automate task discovery and apply instantly.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Controls & Tabs -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div id="tabsContainer" class="flex items-center gap-6 border-b border-white/10 w-full sm:w-auto">
                <button class="tab-btn active pb-3 text-sm font-medium transition-colors" data-filter="all">All</button>
                <button class="tab-btn pb-3 text-sm font-medium text-brand-muted hover:text-white transition-colors" data-filter="bounty">Bounties</button>
                <button class="tab-btn pb-3 text-sm font-medium text-brand-muted hover:text-white transition-colors" data-filter="grant">Grants</button>
                <button class="tab-btn pb-3 text-sm font-medium text-brand-muted hover:text-white transition-colors" data-filter="quest">Quests</button>
            </div>
            
            <div class="flex items-center gap-2">
                <button class="flex items-center gap-2 bg-brand-light border border-white/10 px-3 py-1.5 rounded-lg text-xs font-medium text-brand-muted hover:text-white hover:border-white/20 transition-all">
                    <i data-lucide="sort-desc" class="w-3 h-3"></i> Sort by Value
                </button>
            </div>
        </div>

        <!-- Opportunities Grid -->
        <div id="opportunitiesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 animate-slide-up" style="animation-delay: 0.2s;">
            <% if (opportunities && opportunities.length > 0) { %>
                <% opportunities.forEach(function(op, index) { %>
                    <div class="opportunity-card bento-card p-5 group flex flex-col" data-type="<%= op.type.toLowerCase() %>" data-title="<%= op.title.toLowerCase() %>" data-dao="<%= op.dao.toLowerCase() %>" data-tags="<%= (op.tags || []).join(' ').toLowerCase() %>">
                        
                        <div class="flex justify-between items-start mb-4">
                            <div class="flex items-center gap-2">
                                <% if(op.type.toLowerCase() === 'grant') { %>
                                    <div class="w-8 h-8 rounded bg-[#F5A623]/10 flex items-center justify-center">
                                        <i data-lucide="landmark" class="w-4 h-4 text-[#F5A623]"></i>
                                    </div>
                                <% } else if (op.type.toLowerCase() === 'quest') { %>
                                    <div class="w-8 h-8 rounded bg-emerald-500/10 flex items-center justify-center">
                                        <i data-lucide="map" class="w-4 h-4 text-emerald-400"></i>
                                    </div>
                                <% } else { %>
                                    <div class="w-8 h-8 rounded bg-brand-blue/10 flex items-center justify-center">
                                        <i data-lucide="briefcase" class="w-4 h-4 text-brand-blue"></i>
                                    </div>
                                <% } %>
                                <div>
                                    <span class="text-xs font-bold uppercase tracking-wider text-brand-muted"><%= op.type %></span>
                                </div>
                            </div>
                            
                            <div class="text-right">
                                <% if (op.reward > 0) { %>
                                    <div class="font-display font-bold text-lg text-white">$<%= op.reward.toLocaleString() %></div>
                                <% } else { %>
                                    <div class="font-display font-medium text-sm text-brand-muted mt-1 px-2 py-0.5 bg-white/5 rounded">Open Allocation</div>
                                <% } %>
                            </div>
                        </div>

                        <div class="flex-grow">
                            <h3 class="text-lg font-semibold text-white mb-2 leading-snug group-hover:text-brand-blue transition-colors line-clamp-2"><%= op.title %></h3>
                            <div class="flex items-center gap-3 mb-4">
                                <span class="text-xs text-brand-muted flex items-center gap-1.5">
                                    <div class="w-4 h-4 rounded-full bg-white/10 flex items-center justify-center">
                                        <i data-lucide="building-2" class="w-2.5 h-2.5"></i>
                                    </div>
                                    <%= op.dao %>
                                </span>
                                <span class="w-1 h-1 rounded-full bg-brand-subtle"></span>
                                <span class="text-xs text-brand-muted flex items-center gap-1">
                                    <i data-lucide="clock" class="w-3 h-3 text-emerald-400"></i> <%= op.status.charAt(0).toUpperCase() + op.status.slice(1) %>
                                </span>
                            </div>
                            
                            <!-- Tags -->
                            <div class="flex flex-wrap gap-1.5 mb-5">
                                <% if (op.tags && op.tags.length > 0) { %>
                                    <% op.tags.slice(0, 3).forEach(function(tag) { %>
                                        <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-1 bg-white/5 border border-white/5 text-gray-400 rounded hover:bg-white/10 transition-colors"><%= tag %></span>
                                    <% }); %>
                                    <% if (op.tags.length > 3) { %>
                                        <span class="text-[10px] font-bold px-2 py-1 text-gray-500">+<%= op.tags.length - 3 %></span>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                        
                        <div class="pt-4 border-t border-white/5 opacity-0 group-hover:opacity-100 transition-all translate-y-2 group-hover:translate-y-0 mt-auto">
                            <button class="w-full flex items-center justify-center gap-2 bg-white text-black font-semibold text-sm px-4 py-2.5 rounded-lg hover:bg-gray-200 transition-colors">
                                View Details <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full py-20 flex flex-col items-center justify-center text-brand-muted border-2 border-dashed border-white/5 rounded-2xl">
                    <div class="w-16 h-16 rounded-full bg-brand-light flex items-center justify-center mb-4">
                        <i data-lucide="search-x" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-white font-medium text-lg mb-1">No opportunities found</h3>
                    <p class="text-sm">Try adjusting your filters or search term.</p>
                </div>
            <% } %>
        </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-white/5 py-8 mt-auto bg-brand-light/50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-brand-muted text-sm font-medium">
                <div class="w-5 h-5 rounded bg-brand-blue/20 flex items-center justify-center">
                    <i data-lucide="zap" class="w-3 h-3 text-brand-blue"></i>
                </div>
                © <%= new Date().getFullYear() %> Zero Authority DAO.
            </div>
            <div class="flex items-center gap-6 text-sm font-medium text-brand-muted">
                <a href="https://zeroauthoritydao.com/api-docs" target="_blank" class="hover:text-white transition-colors">API Specs</a>
                <a href="/mcp" class="hover:text-white transition-colors">Model Context Protocol</a>
                <a href="#" class="hover:text-white transition-colors">Terms</a>
            </div>
        </div>
    </footer>

    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        // Client-side filtering and search
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('searchInput');
            const tabBtns = document.querySelectorAll('.tab-btn');
            const cards = document.querySelectorAll('.opportunity-card');
            let currentFilter = 'all';

            function filterCards() {
                const searchTerm = searchInput.value.toLowerCase();
                
                let visibleCount = 0;
                
                cards.forEach(card => {
                    const type = card.dataset.type;
                    const textContent = `${card.dataset.title} ${card.dataset.dao} ${card.dataset.tags}`;
                    
                    const matchesTab = currentFilter === 'all' || type === currentFilter;
                    const matchesSearch = textContent.includes(searchTerm);
                    
                    if (matchesTab && matchesSearch) {
                        card.classList.remove('hidden');
                        card.style.animation = 'none';
                        card.offsetHeight; /* trigger reflow */
                        card.style.animation = `slideUp 0.3s ease-out forwards`;
                        visibleCount++;
                    } else {
                        card.classList.add('hidden');
                    }
                });
                
                // Show empty state if needed based on visibleCount
                // Setup for empty state element can go here.
            }

            searchInput.addEventListener('input', filterCards);

            tabBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    tabBtns.forEach(b => b.classList.remove('active', 'text-white'));
                    tabBtns.forEach(b => b.classList.add('text-brand-muted'));
                    
                    e.target.classList.remove('text-brand-muted');
                    e.target.classList.add('active', 'text-white');
                    
                    currentFilter = e.target.dataset.filter;
                    filterCards();
                });
            });
        });
    </script>
</body>
</html>
