<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <%- include('partials/head', { title: 'Dashboard' }) %>
</head>
<body class="min-h-screen flex font-sans text-brand-text bg-brand-dark relative overflow-x-hidden">
    
    <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

    <div class="flex-grow flex flex-col min-w-0">
        <%- include('partials/topbar') %>

        <main class="flex-grow p-4 sm:p-6 lg:p-10 w-full animate-fade-in lg:ml-64 max-w-7xl mx-auto">
            <!-- Header -->
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
                <div class="max-w-2xl w-full">
                    <h1 class="text-4xl md:text-5xl font-display font-bold text-white mb-2 tracking-tight">Discover your</h1>
                    <h1 class="text-4xl md:text-5xl font-display font-bold text-brand-blue mb-4 tracking-tight">next contribution.</h1>
                    
                    <p class="text-brand-muted text-lg font-light mb-8 max-w-xl leading-relaxed">
                        Find bounties, freelance gigs, events, and open opportunities across top Web3 ecosystems perfectly matched to your skills.
                    </p>
                </div>
            </div>

            <!-- AI Insight Preview -->
            <div class="mb-12 bento-card p-6 border-brand-purple/20 cursor-pointer group hover:border-brand-purple/40" onclick="window.location.href='/ai-scout'">
                <div class="flex flex-col md:flex-row gap-6 items-center">
                    <div class="w-12 h-12 rounded-xl bg-brand-purple/10 text-brand-purple flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                        <i data-lucide="sparkles" class="w-6 h-6"></i>
                    </div>
                    <div class="flex-grow">
                        <h3 class="text-xl font-display font-bold text-white mb-1">Looking for a specific role?</h3>
                        <p class="text-sm text-brand-muted">Try our AI Scout Assistant to find the perfect gigs matching your exact skills and experience.</p>
                    </div>
                    <div>
                        <button class="bg-brand-purple hover:bg-purple-600 text-white rounded-lg px-6 py-2.5 text-sm font-medium transition-all shadow-[0_0_15px_rgba(139,92,246,0.3)] whitespace-nowrap">
                            Launch AI Scout
                        </button>
                    </div>
                </div>
            </div>

            <!-- Dashboard Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">
                
                <!-- Latest Opportunities Preview -->
                <div class="lg:col-span-2 flex flex-col gap-4">
                    <div class="flex items-center justify-between px-2">
                        <h2 class="font-display font-bold text-lg text-white">Live Opportunities</h2>
                        <a href="/opportunities" class="text-sm font-medium text-brand-blue hover:text-brand-blue/80 transition-colors flex items-center gap-1">
                            View all <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% if (opportunities && opportunities.length > 0) { %>
                            <% opportunities.slice(0, 4).forEach(function(op) { %>
                                <div class="bento-card p-5 group flex flex-col h-full cursor-pointer">
                                    <div class="flex justify-between items-start mb-4">
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 rounded bg-white/5 flex items-center justify-center">
                                                <i data-lucide="building-2" class="w-4 h-4 text-brand-muted"></i>
                                            </div>
                                            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted"><%= op.type %></span>
                                        </div>
                                        <% if (op.reward > 0) { %>
                                            <div class="font-display font-bold text-white">$<%= op.reward.toLocaleString() %></div>
                                        <% } %>
                                    </div>
                                    <div class="flex-grow">
                                        <h3 class="text-base font-semibold text-white mb-2 leading-snug"><%= op.title %></h3>
                                        <div class="text-sm text-brand-muted mb-4"><%= op.dao %></div>
                                    </div>
                                    <div class="flex flex-wrap gap-1.5 mt-auto">
                                        <% (op.tags || []).slice(0, 2).forEach(function(tag) { %>
                                            <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-1 bg-white/5 text-gray-400 rounded"><%= tag %></span>
                                        <% }); %>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="col-span-2 bento-card p-10 flex flex-col items-center justify-center text-center">
                                <i data-lucide="compass" class="w-8 h-8 text-brand-muted mb-3"></i>
                                <span class="text-brand-muted font-medium">No opportunities right now</span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Event Preview Sidebar -->
                <div class="flex flex-col gap-4">
                    <div class="flex items-center justify-between px-2">
                        <h2 class="font-display font-bold text-lg text-white">Upcoming Events</h2>
                        <a href="/events" class="text-sm font-medium text-brand-muted hover:text-white transition-colors">See all</a>
                    </div>
                    
                    <div class="bento-card p-4 flex flex-col gap-4">
                        <div class="flex items-start gap-4 p-3 rounded-lg hover:bg-white/5 transition-colors cursor-pointer group border border-transparent hover:border-white/5">
                            <div class="w-12 h-12 rounded-lg bg-emerald-500/10 text-emerald-400 flex flex-col items-center justify-center shrink-0 border border-emerald-500/20">
                                <span class="text-[10px] font-bold uppercase">Oct</span>
                                <span class="text-lg font-display font-bold leading-none">12</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors">DeFi Hackathon</h4>
                                <p class="text-xs text-brand-muted mt-1">Virtual • Hosted by ZA</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start gap-4 p-3 rounded-lg hover:bg-white/5 transition-colors cursor-pointer group border border-transparent hover:border-white/5">
                            <div class="w-12 h-12 rounded-lg bg-brand-blue/10 text-brand-blue flex flex-col items-center justify-center shrink-0 border border-brand-blue/20">
                                <span class="text-[10px] font-bold uppercase">Oct</span>
                                <span class="text-lg font-display font-bold leading-none">15</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-white group-hover:text-brand-blue transition-colors">Community Call</h4>
                                <p class="text-xs text-brand-muted mt-1">Discord • Core Team</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4 p-3 rounded-lg hover:bg-white/5 transition-colors cursor-pointer group border border-transparent hover:border-white/5">
                            <div class="w-12 h-12 rounded-lg bg-orange-500/10 text-orange-400 flex flex-col items-center justify-center shrink-0 border border-orange-500/20">
                                <span class="text-[10px] font-bold uppercase">Oct</span>
                                <span class="text-lg font-display font-bold leading-none">18</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-white group-hover:text-orange-400 transition-colors">Governance Spc</h4>
                                <p class="text-xs text-brand-muted mt-1">Twitter Space</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <%- include('partials/footer_scripts') %>
</body>
</html>