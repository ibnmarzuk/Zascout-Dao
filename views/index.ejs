<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <%- include('partials/head', { title: 'Dashboard' }) %>
</head>
<body class="min-h-screen flex font-sans text-brand-text bg-brand-dark relative overflow-x-hidden">
    
    <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

    <div class="flex-grow flex flex-col min-w-0 lg:pl-64">
        <%- include('partials/topbar') %>

        <main class="flex-grow p-4 sm:p-6 lg:p-10 w-full animate-fade-in max-w-7xl mx-auto">
            <!-- ZA Scout Onboarding Landing Hero -->
            <div class="relative overflow-hidden bento-card p-6 sm:p-8 md:p-10 border border-brand-blue/20 bg-gradient-to-br from-brand-blue/10 via-black/40 to-brand-purple/5 mb-10 group rounded-3xl">
                <!-- Decorative Blur Glows -->
                <div class="absolute -right-16 -top-16 w-64 h-64 bg-brand-blue/10 rounded-full blur-3xl group-hover:bg-brand-blue/15 transition-all duration-700"></div>
                <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-brand-purple/10 rounded-full blur-3xl group-hover:bg-brand-purple/15 transition-all duration-700"></div>
                
                <div class="relative z-10 max-w-3xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-blue/10 border border-brand-blue/20 text-brand-blue text-xs font-semibold uppercase tracking-wider mb-5 font-mono animate-pulse">
                        <i data-lucide="info" class="w-3.5 h-3.5"></i> Platform Briefing
                    </div>
                    
                    <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-extrabold text-white mb-4 tracking-tight leading-none">
                        Welcome to <span class="bg-gradient-to-r from-brand-blue via-brand-purple to-emerald-400 bg-clip-text text-transparent">ZA Scout</span>
                    </h1>
                    
                    <p class="text-brand-text text-base sm:text-lg mb-6 leading-relaxed max-w-2xl font-light">
                        We are building the ultimate decentralized <strong class="text-white font-medium">Web3 Contributor Hub and open Bounty Explorer</strong>. 
                        Our platform empowers developers, designers, writers, and community builders to claim active challenges, 
                        build verified reputational identity (<span class="text-brand-purple font-semibold font-mono">REP</span>), earn digital rewards, 
                        and collaborate natively across top decentralized organizations — with zero centralized gatekeeping.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mt-6">
                        <a href="/quests" id="hero-explore-btn" class="text-center bg-brand-blue hover:bg-opacity-95 text-black font-extrabold px-6 py-3 rounded-xl text-sm transition-all shadow-[0_0_20px_rgba(0,112,243,0.30)] flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-[0.98] transform">
                            Explore Live Quests <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                        <a href="/ai-scout" id="hero-scout-btn" class="text-center bg-white/5 border border-white/10 hover:bg-white/10 hover:border-brand-purple/30 text-white font-semibold px-6 py-3 rounded-xl text-sm transition-all flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-[0.98] transform">
                            <i data-lucide="cpu" class="w-4 h-4 text-brand-purple"></i> Smart Match via AI Scout
                        </a>
                    </div>
                </div>
            </div>

            <!-- AI Insight Preview -->
            <div class="mb-12 bento-card p-6 border-brand-purple/20 cursor-pointer group hover:border-brand-purple/40" onclick="window.location.href='/ai-scout'">
                <div class="flex flex-col md:flex-row gap-6 items-center">
                    <div class="w-12 h-12 rounded-xl bg-brand-purple/10 text-brand-purple flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                        <i data-lucide="sparkles" class="w-6 h-6"></i>
                    </div>
                    <div class="flex-grow">
                        <h3 class="text-xl font-display font-bold text-white mb-1">Looking for a specific role?</h3>
                        <p class="text-sm text-brand-muted">Try our AI Scout Assistant to find the perfect gigs matching your exact skills and experience.</p>
                    </div>
                    <div>
                        <button class="bg-brand-purple hover:bg-purple-600 text-white rounded-lg px-6 py-2.5 text-sm font-medium transition-all shadow-[0_0_15px_rgba(139,92,246,0.3)] whitespace-nowrap active:scale-[0.98]">
                            Launch AI Scout
                        </button>
                    </div>
                </div>
            </div>

            <!-- Dashboard Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">
                
                <!-- Latest Opportunities Preview -->
                <div class="lg:col-span-2 flex flex-col gap-4">
                    <div class="flex items-center justify-between px-2">
                        <h2 class="font-display font-bold text-lg text-white">Live Opportunities</h2>
                        <a href="/opportunities" class="text-sm font-medium text-brand-blue hover:text-brand-blue/80 transition-colors flex items-center gap-1">
                            View all <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% if (opportunities && opportunities.length > 0) { %>
                            <% opportunities.slice(0, 4).forEach(function(op) { %>
                                <div id="bounty-card-<%= op.id %>" class="bento-card p-5 group flex flex-col h-full cursor-pointer hover:border-brand-purple/30 transition-all relative border border-white/5" onclick="openGlobalBountyDetail('<%= op.id %>')">
                                    <div class="flex justify-between items-start mb-4">
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 rounded bg-white/5 flex items-center justify-center">
                                                <i data-lucide="building-2" class="w-4 h-4 text-brand-muted"></i>
                                            </div>
                                            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted"><%= op.type %></span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <% if (op.reward > 0) { %>
                                                <div class="font-display font-bold text-white">$<%= op.reward.toLocaleString() %></div>
                                            <% } %>
                                            <button onclick="toggleSaveBounty(event, '<%= op.id %>')" class="p-1.5 rounded-lg bg-white/5 border border-white/5 hover:border-brand-purple/20 text-brand-muted hover:text-brand-purple hover:bg-brand-purple/10 transition-all cursor-pointer pointer-events-auto active:scale-[0.9] transform" title="Save Opportunity">
                                                <i data-lucide="bookmark" class="w-3.5 h-3.5" id="save-icon-<%= op.id %>"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="flex-grow">
                                        <h3 class="text-base font-semibold text-white mb-1 leading-snug"><%= op.title %></h3>
                                        <div class="text-xs text-brand-purple font-semibold mb-2"><%= op.dao %></div>
                                        <% if (op.description) { %>
                                            <p class="text-xs text-brand-muted line-clamp-2 group-hover:line-clamp-none transition-all duration-300 leading-relaxed mb-4"><%= op.description %></p>
                                        <% } else { %>
                                            <div class="mb-4"></div>
                                        <% } %>
                                    </div>
                                    <div class="flex flex-wrap gap-1.5 mt-auto">
                                        <% (op.tags || []).slice(0, 2).forEach(function(tag) { %>
                                            <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-1 bg-white/5 text-gray-400 rounded"><%= tag %></span>
                                        <% }); %>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="col-span-2 bento-card p-10 flex flex-col items-center justify-center text-center">
                                <i data-lucide="compass" class="w-8 h-8 text-brand-muted mb-3"></i>
                                <span class="text-brand-muted font-medium">No opportunities right now</span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Event Preview Sidebar -->
                <div class="flex flex-col gap-4">
                    <div class="flex items-center justify-between px-2">
                        <h2 class="font-display font-bold text-lg text-white">Upcoming Events</h2>
                        <a href="/events" class="text-sm font-medium text-brand-muted hover:text-white transition-colors">See all</a>
                    </div>
                    
                    <div class="bento-card p-4 flex flex-col gap-4">
                        <div class="flex items-start gap-4 p-3 rounded-lg hover:bg-white/5 transition-colors cursor-pointer group border border-transparent hover:border-white/5" onclick="window.location.href='/events'">
                            <div class="w-12 h-12 rounded-lg bg-brand-blue/10 text-brand-blue flex flex-col items-center justify-center shrink-0 border border-brand-blue/20">
                                <span class="text-[10px] font-bold uppercase">May</span>
                                <span class="text-lg font-display font-bold leading-none">12</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-white group-hover:text-brand-blue transition-colors">DeFi Governance Space</h4>
                                <p class="text-xs text-brand-muted mt-1">Twitter Space • ZA Scout</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start gap-4 p-3 rounded-lg hover:bg-white/5 transition-colors cursor-pointer group border border-transparent hover:border-white/5" onclick="window.location.href='/events'">
                            <div class="w-12 h-12 rounded-lg bg-emerald-500/10 text-emerald-400 flex flex-col items-center justify-center shrink-0 border border-emerald-500/20">
                                <span class="text-[10px] font-bold uppercase">May</span>
                                <span class="text-lg font-display font-bold leading-none">15</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors">Smart Contract Workshop</h4>
                                <p class="text-xs text-brand-muted mt-1">Virtual Workshop • Optimism</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4 p-3 rounded-lg hover:bg-white/5 transition-colors cursor-pointer group border border-transparent hover:border-white/5" onclick="window.location.href='/events'">
                            <div class="w-12 h-12 rounded-lg bg-brand-purple/10 text-brand-purple flex flex-col items-center justify-center shrink-0 border border-brand-purple/20">
                                <span class="text-[10px] font-bold uppercase">May</span>
                                <span class="text-lg font-display font-bold leading-none">20</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-white group-hover:text-brand-purple transition-colors">DAO Governance Call</h4>
                                <p class="text-xs text-brand-muted mt-1">Community Call • ZA Scout</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- Task Manager -->
            <div class="bento-card p-6 border border-white/5 bg-black/40">
                <h2 class="font-display font-bold text-lg text-white mb-4">My Tasks</h2>
                <div class="flex gap-2 mb-4">
                    <input type="text" id="task-input" placeholder="Add a new personal task..." class="flex-grow bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-sm text-white placeholder-brand-muted focus:outline-none focus:border-brand-purple/50">
                    <button onclick="addTask()" class="bg-brand-blue hover:bg-opacity-95 text-black px-4 py-2 rounded-lg text-sm font-semibold transition-all">Add</button>
                </div>
                <ul id="task-list" class="space-y-2">
                    <!-- Tasks will be injected here -->
                </ul>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', loadTasks);

                function loadTasks() {
                    const tasks = JSON.parse(localStorage.getItem('userTasks') || '[]');
                    const list = document.getElementById('task-list');
                    list.innerHTML = '';
                    tasks.forEach((task, index) => {
                        const li = document.createElement('li');
                        li.className = 'flex items-center gap-3 bg-white/[0.02] p-3 rounded-lg border border-white/5';
                        li.innerHTML = `
                            <input type="checkbox" ${task.completed ? 'checked' : ''} onchange="toggleTask(${index})" class="accent-brand-blue">
                            <span class="${task.completed ? 'line-through text-brand-muted' : 'text-white'} text-sm flex-grow">${task.text}</span>
                            <button onclick="deleteTask(${index})" class="text-brand-muted hover:text-red-400">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        `;
                        list.appendChild(li);
                    });
                    // Re-render icons if needed (might not work well without re-initializing icons if they are not in footer scripts)
                }

                function addTask() {
                    const input = document.getElementById('task-input');
                    if (!input.value.trim()) return;
                    const tasks = JSON.parse(localStorage.getItem('userTasks') || '[]');
                    tasks.push({ text: input.value, completed: false });
                    localStorage.setItem('userTasks', JSON.stringify(tasks));
                    input.value = '';
                    loadTasks();
                }

                function toggleTask(index) {
                    const tasks = JSON.parse(localStorage.getItem('userTasks') || '[]');
                    tasks[index].completed = !tasks[index].completed;
                    localStorage.setItem('userTasks', JSON.stringify(tasks));
                    loadTasks();
                }

                function deleteTask(index) {
                    const tasks = JSON.parse(localStorage.getItem('userTasks') || '[]');
                    tasks.splice(index, 1);
                    localStorage.setItem('userTasks', JSON.stringify(tasks));
                    loadTasks();
                }
            </script>
        </main>
    </div>

    <%- include('partials/footer_scripts') %>
</body>
</html>