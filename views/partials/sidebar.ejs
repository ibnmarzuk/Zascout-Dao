<!-- Sidebar -->
<aside class="w-64 fixed inset-y-0 left-0 bg-brand-dark border-r border-white/5 hidden lg:flex flex-col z-40">
    <div class="h-16 flex items-center px-6 border-b border-white/5">
        <a href="/" class="flex items-center gap-2 group">
            <svg viewBox="0 0 100 100" class="w-8 h-8 relative z-10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="50" r="42" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2" class="text-brand-blue/50"/>
                <!-- Compass Markings -->
                <path d="M50 15V22M50 78V85M15 50H22M78 50H85" stroke="currentColor" stroke-width="1.5" class="text-brand-blue"/>
                <g transform="rotate(45, 50, 50)">
                    <path d="M50 25L56 50L50 75L44 50L50 25Z" fill="url(#logo-gradient)" class="drop-shadow-[0_0_8px_rgba(0,112,243,0.8)]"/>
                </g>
                <defs>
                    <linearGradient id="logo-gradient" x1="50" y1="25" x2="50" y2="75" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#0070F3"/>
                        <stop offset="1" stop-color="#8b5cf6"/>
                    </linearGradient>
                </defs>
            </svg>
            <span class="font-display font-bold text-lg text-white tracking-tight">ZA Scout</span>
        </a>
    </div>
    
    <div class="flex-grow overflow-y-auto py-6 px-4 flex flex-col gap-1">
        <div class="text-[10px] font-bold text-brand-muted uppercase tracking-wider px-3 mb-2">Platform</div>
        <a href="/" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg text-brand-muted hover:text-white hover:bg-white/5 transition-colors <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'bg-white/5 text-white' : '' %>">
