        <a href="/bounties" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg text-brand-muted hover:text-white hover:bg-white/5 transition-colors <%= typeof activePage !== 'undefined' && activePage === 'bounties' ? 'bg-white/5 text-white' : '' %>">
