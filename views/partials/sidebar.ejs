        <a href="/ai-scout" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg text-brand-purple hover:bg-brand-purple/10 transition-colors <%= typeof activePage !== 'undefined' && activePage === 'ai-scout' ? 'bg-brand-purple/10 text-brand-purple' : '' %>">
