<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <%- include('partials/head', { title: 'AI Scout' }) %>
    <style>
        .typing-indicator span {
            animation: blink 1.4s infinite both;
            height: 6px;
            width: 6px;
            background-color: theme('colors.brand.purple');
            border-radius: 50%;
            display: inline-block;
            margin: 0 1px;
        }
        .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes blink {
            0% { opacity: 0.2; }
            20% { opacity: 1; }
            100% { opacity: 0.2; }
        }
        .message-enter {
            animation: messageFadeIn 0.3s ease-out forwards;
        }
        @keyframes messageFadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="min-h-[100dvh] flex font-sans text-brand-text bg-brand-dark relative overflow-hidden">
    
    <%- include('partials/sidebar', { activePage: 'ai-scout' }) %>

    <div class="flex-grow flex flex-col min-w-0 h-[100dvh] lg:pl-64">
        <%- include('partials/topbar') %>

        <main class="flex-grow flex flex-col p-3 sm:p-5 md:p-6 lg:p-8 w-full max-w-5xl mx-auto h-[calc(100dvh-4rem)] max-h-[calc(100dvh-4rem)] lg:h-[calc(100dvh)] lg:max-h-[calc(100dvh)] overflow-hidden">
            
            <!-- Chat History Area -->
            <div id="chatHistory" class="flex-grow overflow-y-auto pr-1 sm:pr-2 pb-4 flex flex-col gap-4 sm:gap-6 custom-scrollbar">
                
                <!-- Initial Welcome State -->
                <div class="flex-grow flex flex-col items-center justify-center text-center px-2 sm:px-4 py-4 sm:py-6 my-auto" id="welcomeState">
                    <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-2xl bg-brand-purple/10 text-brand-purple flex items-center justify-center mb-3 sm:mb-4 border border-brand-purple/20 shrink-0">
                        <i data-lucide="bot" class="w-6 h-6 sm:w-8 sm:h-8"></i>
                    </div>
                    <h1 class="text-xl sm:text-2xl md:text-3xl font-display font-bold text-white mb-2">How can I help you find work?</h1>
                    <p class="text-brand-muted max-w-sm mx-auto mb-4 sm:mb-6 text-xs sm:text-sm leading-relaxed">I analyze thousands of active bounties, grants, and freelance gigs across the Web3 ecosystem to find your perfect match.</p>
                    
                    <!-- Premium AI Scout Status Panel -->
                    <div class="mb-4 sm:mb-6 flex flex-wrap gap-2 items-center justify-center text-[10px] sm:text-[11px]">
                        <div class="bg-brand-purple/10 border border-brand-purple/20 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full text-brand-purple flex items-center gap-1.5 font-mono">
                            <span class="relative flex h-1.5 w-1.5 sm:h-2 sm:w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-purple opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-1.5 w-1.5 sm:h-2 sm:w-2 bg-brand-purple"></span>
                            </span>
                            Ecosystem Scout Online
                        </div>
                        <div class="bg-white/5 border border-white/10 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full text-brand-muted flex items-center gap-1.5 font-mono">
                            <i data-lucide="bookmark" class="w-3.5 h-3.5 text-brand-purple"></i>
                            <span id="savedCountSpan" class="text-white font-bold">0</span> Bookmarked
                        </div>
                    </div>
 
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3 w-full max-w-2xl mb-4 sm:mb-6">
                        <button class="prompt-suggestion text-left p-3.5 sm:p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 hover:border-brand-purple/30 transition-all group">
                            <span class="block text-xs sm:text-sm font-semibold text-white mb-1 group-hover:text-brand-purple transition-colors">"Find frontend DAO gigs"</span>
                            <span class="block text-[10px] sm:text-xs text-brand-muted">React, Web3, and UI bounties</span>
                        </button>
                        <button class="prompt-suggestion text-left p-3.5 sm:p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 hover:border-brand-purple/30 transition-all group">
                            <span class="block text-xs sm:text-sm font-semibold text-white mb-1 group-hover:text-brand-purple transition-colors">"Show beginner friendly bounties"</span>
                            <span class="block text-[10px] sm:text-xs text-brand-muted">Good first issues & documentation</span>
                        </button>
                        <button class="prompt-suggestion text-left p-3.5 sm:p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 hover:border-brand-purple/30 transition-all group">
                            <span class="block text-xs sm:text-sm font-semibold text-white mb-1 group-hover:text-brand-purple transition-colors">"Find upcoming hackathons"</span>
                            <span class="block text-[10px] sm:text-xs text-brand-muted">Events, prizes, and teams</span>
                        </button>
                        <button class="prompt-suggestion text-left p-3.5 sm:p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 hover:border-brand-purple/30 transition-all group">
                            <span class="block text-xs sm:text-sm font-semibold text-white mb-1 group-hover:text-brand-purple transition-colors">"Opportunities for designers"</span>
                            <span class="block text-[10px] sm:text-xs text-brand-muted">UX research, branding, UI kits</span>
                        </button>
                    </div>
 
                    <!-- Bookmarked Opportunities Stash Dashboard -->
                    <div id="savedOpportunitiesDashboard" class="w-full max-w-2xl mt-2 sm:mt-4 pt-4 sm:pt-6 border-t border-white/5 text-left hidden">
                        <div class="flex items-center justify-between mb-3 px-1">
                            <h3 class="text-[10px] sm:text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
                                <i data-lucide="bookmark-check" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-brand-purple fill-[currentcolor]"></i>
                                Scout Saved Stash
                            </h3>
                            <span class="text-[9px] sm:text-[10px] text-brand-muted font-mono" id="savedCountLabel">0 saved</span>
                        </div>
                        <div id="savedItemsList" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3 max-h-36 sm:max-h-48 overflow-y-auto custom-scrollbar pr-1">
                            <!-- populated dynamically -->
                        </div>
                    </div>
                </div>
 
            </div>
 
            <!-- Input Area -->
            <div class="mt-auto shrink-0 pt-4 pb-2 relative z-10 border-t border-white/5 sm:border-t-0 bg-brand-dark">
                <div class="relative max-w-4xl mx-auto px-1 sm:px-0">
                    <form id="aiChatForm" class="flex gap-2">
                        <div class="relative flex-grow">
                            <div class="absolute left-3.5 sm:left-4 top-1/2 -translate-y-1/2 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-brand-purple/20 flex items-center justify-center">
                                <i data-lucide="sparkles" class="w-3.5 h-3.5 text-brand-purple"></i>
                            </div>
                            <!-- Added native CSRF mechanism if needed but assuming JS fetching handles it -->
                            <input type="text" id="aiInput" autocomplete="off" placeholder="Ask AI Scout..." class="w-full bg-brand-light border border-white/10 rounded-xl sm:rounded-2xl pl-12 sm:pl-14 pr-11 sm:pr-12 py-3 sm:py-4 text-sm sm:text-base text-white placeholder:text-brand-muted focus:outline-none focus:border-brand-purple/50 focus:ring-4 focus:ring-brand-purple/10 transition-all shadow-xl">
                            <button type="button" class="absolute right-3.5 sm:right-4 top-1/2 -translate-y-1/2 text-brand-muted hover:text-white transition-colors">
                                <i data-lucide="mic" class="w-4.5 h-4.5 sm:w-5 sm:h-5"></i>
                            </button>
                        </div>
                        <button type="submit" class="shrink-0 bg-white text-black hover:bg-gray-200 rounded-xl sm:rounded-2xl px-4 sm:px-6 font-bold transition-all flex items-center justify-center shadow-lg active:scale-95 disabled:opacity-50 disabled:pointer-events-none">
                            <i data-lucide="arrow-up" class="w-4.5 h-4.5 sm:w-5 sm:h-5"></i>
                        </button>
                    </form>
                    <div class="text-center mt-2.5 text-[9px] sm:text-[10px] text-brand-muted">
                        AI Scout can make mistakes. Verify critical dates and requirements directly with DAOs.
                    </div>
                </div>
            </div>

        </main>
    </div>

    <%- include('partials/footer_scripts') %>

    <script>
        const chatForm = document.getElementById('aiChatForm');
        const aiInput = document.getElementById('aiInput');
        const chatHistory = document.getElementById('chatHistory');
        const welcomeState = document.getElementById('welcomeState');

        // Setup csrf token mapping safely inline
        const csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

        // Suggestion buttons
        document.querySelectorAll('.prompt-suggestion').forEach(btn => {
            btn.addEventListener('click', () => {
                const text = btn.querySelector('span').textContent.replace(/"/g, '');
                aiInput.value = text;
                chatForm.dispatchEvent(new Event('submit'));
            });
        });

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const query = aiInput.value.trim();
            if (!query) return;

            // Remove welcome state if present
            if (welcomeState && welcomeState.style.display !== 'none') {
                welcomeState.style.display = 'none';
            }

            // Append user message
            appendUserMessage(query);
            aiInput.value = '';

            // Append loading indicator
            const loadingId = 'loading-' + Date.now();
            appendLoading(loadingId);
            scrollToBottom();

            try {
                // Example API call to our backend (which uses Gemini)
                const response = await fetch('/api/ai/discover', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({ query })
                });

                const data = await response.json();
                
                // Remove loading
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();

                // Append AI Response
                appendAiResponse(data);
                scrollToBottom();
                lucide.createIcons();
                
            } catch (error) {
                console.error("AI Error:", error);
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();
                
                // Fallback / Error UI
                appendAiError("I'm sorry, I couldn't connect to the scouting network at the moment. Please try again later.");
                scrollToBottom();
            }
        });

        function appendUserMessage(text) {
            const html = `
                <div class="flex justify-end message-enter w-full max-w-4xl mx-auto">
                    <div class="bg-brand-light border border-white/5 rounded-2xl rounded-tr-sm px-4 py-2.5 sm:px-5 sm:py-3 text-white max-w-[85%] sm:max-w-[80%] shadow-lg text-sm">
                        ${text}
                    </div>
                </div>
            `;
            chatHistory.insertAdjacentHTML('beforeend', html);
        }

        function appendLoading(id) {
            const html = `
                <div id="${id}" class="flex justify-start message-enter w-full max-w-4xl mx-auto">
                    <div class="flex gap-2.5 sm:gap-4 max-w-full sm:max-w-[90%]">
                        <div class="shrink-0 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-brand-purple/20 text-brand-purple flex items-center justify-center border border-brand-purple/30">
                            <i data-lucide="bot" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
                        </div>
                        <div class="bg-brand-light border border-white/5 rounded-xl sm:rounded-2xl rounded-tl-sm px-4 py-3 sm:px-5 sm:py-4 shadow-lg min-w-[80px] flex items-center">
                            <div class="typing-indicator">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            chatHistory.insertAdjacentHTML('beforeend', html);
            lucide.createIcons();
        }

        function appendAiError(msg) {
            const html = `
                <div class="flex justify-start message-enter w-full max-w-4xl mx-auto">
                    <div class="flex gap-2.5 sm:gap-4 max-w-full sm:max-w-[90%]">
                        <div class="shrink-0 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-red-500/20 text-red-500 flex items-center justify-center border border-red-500/30">
                            <i data-lucide="alert-circle" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
                        </div>
                        <div class="bg-brand-light border border-white/5 rounded-xl sm:rounded-2xl rounded-tl-sm px-4 py-3 sm:px-5 sm:py-4 text-brand-muted shadow-lg text-xs sm:text-sm">
                            ${msg}
                        </div>
                    </div>
                </div>
            `;
            chatHistory.insertAdjacentHTML('beforeend', html);
            lucide.createIcons();
        }

        function appendAiResponse(data) {
            const summary = data.summary || "Here are some opportunities that match your request based on the current ecosystem state.";
            
            // Build suggestion cards based on metadata
            let cardsHtml = '';
            
            let matches = data.matches || [];
            if (matches.length === 0 && data.recommendations && data.recommendations.length > 0) {
                // Map legacy predictions/recommendations structure to matches array dynamically
                matches = data.recommendations.map((rec, i) => {
                    const id = `scout-rec-${i}`;
                    const dao = (data.daos && data.daos[i]) || "Web3 DAO";
                    const isGig = rec.toLowerCase().includes("developer") || rec.toLowerCase().includes("writer") || rec.toLowerCase().includes("manager");
                    return {
                        id: id,
                        title: rec,
                        type: isGig ? "Gig" : "Bounty",
                        dao: dao,
                        reward: isGig ? "$2,500/mo" : "250 OP",
                        tags: data.skills || ["General"],
                        matchReason: `Suggested by expert matching for "${data.keywords ? data.keywords.join(', ') : 'ecosystem'}"`
                    };
                });
            }
            
            if (matches.length > 0) {
                cardsHtml = `
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mt-3 sm:mt-4">
                        ${matches.map((m) => {
                            const isSaved = getSavedBounties().includes(m.id);
                            const cardId = `bounty-card-${m.id}`;
                            const saveIconId = `save-icon-${m.id}`;
                            const badgeColor = m.type?.toLowerCase() === 'grant' ? 'bg-brand-blue/10 text-brand-blue border-brand-blue/20' : 'bg-brand-purple/10 text-brand-purple border-brand-purple/20';
                            
                            return `
                                <div id="${cardId}" onclick="openGlobalBountyDetail('${m.id}')" 
                                     class="bento-card p-4 sm:p-5 group flex flex-col justify-between cursor-pointer border ${isSaved ? 'border-brand-purple/40 bg-brand-purple/[0.02]' : 'border-white/5'} hover:border-brand-purple/30 transition-all relative">
                                    
                                    <div>
                                        <div class="flex justify-between items-start gap-4 mb-2">
                                            <span class="px-2 py-0.5 rounded text-[9px] sm:text-[10px] uppercase font-bold tracking-wider border ${badgeColor}">
                                                ${m.type || 'Bounty'}
                                            </span>
                                            
                                            <div class="flex items-center gap-1.5 sm:gap-2">
                                                ${isSaved ? `
                                                    <span class="saved-pill-badge px-2 py-0.5 rounded-full bg-brand-purple/10 border border-brand-purple/30 text-brand-purple text-[8px] sm:text-[10px] font-bold font-mono uppercase tracking-wider scale-95 animate-fade-in shrink-0">
                                                        <i class="w-2.5 h-2.5 sm:w-3 sm:h-3 inline mr-0.5 sm:mr-1 leading-none" data-lucide="bookmark-check"></i>Saved
                                                    </span>
                                                ` : ''}
                                                <button onclick="toggleSaveBounty(event, '${m.id}')" 
                                                        class="${isSaved ? 'bg-brand-purple/10 border-brand-purple/20 text-brand-purple' : 'bg-white/5 border-white/5 text-brand-muted'} p-1.5 rounded-md border hover:border-brand-purple/20 hover:text-brand-purple hover:bg-brand-purple/10 transition-all flex items-center justify-center shrink-0" 
                                                        title="Save Opportunity">
                                                    <i data-lucide="bookmark" class="w-3.5 h-3.5 sm:w-4 sm:h-4 ${isSaved ? 'text-brand-purple fill-[currentcolor]' : 'text-brand-muted'}" id="${saveIconId}"></i>
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <h4 class="text-white font-bold text-xs sm:text-sm mb-0.5 sm:mb-1 group-hover:text-brand-purple transition-colors line-clamp-1">
                                            ${m.title}
                                        </h4>
                                        <p class="text-[10px] sm:text-xs text-brand-muted mb-2 sm:mb-3 font-mono">
                                            <span>${m.dao}</span> • <span class="text-emerald-400 font-bold">${m.reward}</span>
                                        </p>
                                        
                                        ${m.matchReason ? `
                                            <div class="text-[10px] sm:text-[11px] text-brand-muted bg-white/[0.02] border border-white/5 rounded-lg p-2 sm:p-2.5 mb-2.5 sm:mb-3 leading-normal">
                                                <span class="text-brand-purple font-semibold">Match:</span> ${m.matchReason}
                                            </div>
                                        ` : ''}
                                    </div>
                                    
                                    <div class="flex gap-1 sm:gap-1.5 flex-wrap mt-auto">
                                        ${(m.tags || []).slice(0, 3).map(tag => `
                                            <span class="px-1.5 py-0.5 sm:px-2 sm:py-0.5 rounded bg-white/5 border border-white/5 text-brand-text text-[9px] sm:text-[10px] font-medium font-mono">
                                                ${tag}
                                            </span>
                                        `).join('')}
                                    </div>
                                </div>
                            `;
                        }).join('')}
                    </div>
                `;
            }

            const html = `
                <div class="flex justify-start message-enter w-full max-w-4xl mx-auto">
                    <div class="flex gap-2.5 sm:gap-4 max-w-full sm:max-w-[90%] w-full">
                        <div class="shrink-0 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-brand-purple/20 text-brand-purple flex items-center justify-center border border-brand-purple/30">
                            <i data-lucide="bot" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
                        </div>
                        <div class="bg-brand-light border border-white/5 rounded-xl sm:rounded-2xl rounded-tl-sm p-3.5 sm:p-5 shadow-lg w-full">
                            <p class="text-brand-text text-xs sm:text-sm leading-relaxed">${summary}</p>
                            ${cardsHtml}
                            <div class="mt-3.5 sm:mt-4 pt-2.5 sm:pt-3 border-t border-white/5 flex gap-2">
                                <button onclick="aiInput.value='Developer'; chatForm.dispatchEvent(new Event('submit'));" class="text-[10px] sm:text-xs font-medium text-brand-muted hover:text-white px-2.5 py-1.5 sm:px-3 sm:py-1.5 rounded bg-white/5 hover:bg-white/10 transition-colors">Apply Filters</button>
                                <button onclick="aiInput.focus();" class="text-[10px] sm:text-xs font-medium text-brand-muted hover:text-white px-2.5 py-1.5 sm:px-3 sm:py-1.5 rounded bg-white/5 hover:bg-white/10 transition-colors">Start New Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            chatHistory.insertAdjacentHTML('beforeend', html);
        }

        function scrollToBottom() {
            chatHistory.scrollTo({
                top: chatHistory.scrollHeight,
                behavior: 'smooth'
            });
        }

        function loadScoutSavedDashboard() {
            const savedIds = getSavedBounties();
            const badgeSpan = document.getElementById('savedCountSpan');
            if (badgeSpan) badgeSpan.textContent = savedIds.length;
            
            const dashboard = document.getElementById('savedOpportunitiesDashboard');
            const listContainer = document.getElementById('savedItemsList');
            const countLabel = document.getElementById('savedCountLabel');
            
            if (!dashboard || !listContainer) return;
            
            if (savedIds.length === 0) {
                dashboard.classList.add('hidden');
                return;
            }
            
            dashboard.classList.remove('hidden');
            if (countLabel) countLabel.textContent = `${savedIds.length} saved`;
            
            listContainer.innerHTML = '';
            
            savedIds.forEach(id => {
                let item = GLOBAL_BOUNTIES_DB.find(b => b.id === id);
                if (!item) {
                     item = {
                         id: id,
                         title: "Decentralized Challenge",
                         dao: "Web3 Partner",
                         reward: "+100 REP",
                         type: "Bounty"
                     };
                }
                
                const itemHtml = `
                    <div id="stash-item-${item.id}" onclick="openGlobalBountyDetail('${item.id}')" class="p-3 bg-white/5 border border-white/5 hover:border-brand-purple/20 hover:bg-white/[0.08] transition-all rounded-xl flex items-center justify-between cursor-pointer group">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-8 h-8 rounded bg-white/5 flex items-center justify-center shrink-0 border border-white/10">
                                <i data-lucide="award" class="w-4 h-4 text-brand-purple/70 group-hover:text-brand-purple transition-all"></i>
                            </div>
                            <div class="min-w-0">
                                <h4 class="text-xs font-bold text-white truncate group-hover:text-brand-purple transition-colors">${item.title}</h4>
                                <p class="text-[10px] text-brand-muted truncate">${item.dao} • <span class="text-emerald-400 font-medium">${item.reward}</span></p>
                            </div>
                        </div>
                        <button onclick="toggleSaveBounty(event, '${item.id}'); setTimeout(loadScoutSavedDashboard, 100);" class="p-1.5 bg-white/5 hover:bg-red-500/10 border border-white/10 text-brand-muted hover:text-red-400 rounded-lg transition-all ml-2" title="Remove">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                `;
                listContainer.insertAdjacentHTML('beforeend', itemHtml);
            });
            lucide.createIcons();
        }

        // Register window access and trigger initialization
        window.loadScoutSavedDashboard = loadScoutSavedDashboard;
        
        window.addEventListener('DOMContentLoaded', () => {
            loadScoutSavedDashboard();
        });
    </script>
</body>
</html>