<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <%- include('partials/head', { title: 'AI Scout' }) %>
    <style>
        .typing-indicator span {
            animation: blink 1.4s infinite both;
            height: 6px;
            width: 6px;
            background-color: theme('colors.brand.purple');
            border-radius: 50%;
            display: inline-block;
            margin: 0 1px;
        }
        .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes blink {
            0% { opacity: 0.2; }
            20% { opacity: 1; }
            100% { opacity: 0.2; }
        }
        .message-enter {
            animation: messageFadeIn 0.3s ease-out forwards;
        }
        @keyframes messageFadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="min-h-screen flex font-sans text-brand-text bg-brand-dark relative overflow-hidden">
    
    <%- include('partials/sidebar', { activePage: 'ai-scout' }) %>

    <div class="flex-grow flex flex-col min-w-0 h-screen lg:pl-64">
        <%- include('partials/topbar') %>

        <main class="flex-grow flex flex-col p-4 sm:p-6 lg:p-8 w-full max-w-5xl mx-auto h-[calc(100vh-4rem)]">
            
            <!-- Chat History Area -->
            <div id="chatHistory" class="flex-grow overflow-y-auto pr-2 pb-4 flex flex-col gap-6 custom-scrollbar">
                
                <!-- Initial Welcome State -->
                <div class="flex flex-col items-center justify-center h-full text-center px-4" id="welcomeState">
                    <div class="w-16 h-16 rounded-2xl bg-brand-purple/10 text-brand-purple flex items-center justify-center mb-6 border border-brand-purple/20">
                        <i data-lucide="bot" class="w-8 h-8"></i>
                    </div>
                    <h1 class="text-3xl font-display font-bold text-white mb-2">How can I help you find work?</h1>
                    <p class="text-brand-muted max-w-md mx-auto mb-8">I analyze thousands of active bounties, grants, and freelance gigs across the Web3 ecosystem to find your perfect match.</p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full max-w-2xl">
                        <button class="prompt-suggestion text-left p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 hover:border-brand-purple/30 transition-all group">
                            <span class="block text-sm font-semibold text-white mb-1 group-hover:text-brand-purple transition-colors">"Find frontend DAO gigs"</span>
                            <span class="block text-xs text-brand-muted">React, Web3, and UI bounties</span>
                        </button>
                        <button class="prompt-suggestion text-left p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 hover:border-brand-purple/30 transition-all group">
                            <span class="block text-sm font-semibold text-white mb-1 group-hover:text-brand-purple transition-colors">"Show beginner friendly bounties"</span>
                            <span class="block text-xs text-brand-muted">Good first issues & documentation</span>
                        </button>
                        <button class="prompt-suggestion text-left p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 hover:border-brand-purple/30 transition-all group">
                            <span class="block text-sm font-semibold text-white mb-1 group-hover:text-brand-purple transition-colors">"Find upcoming hackathons"</span>
                            <span class="block text-xs text-brand-muted">Events, prizes, and teams</span>
                        </button>
                        <button class="prompt-suggestion text-left p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 hover:border-brand-purple/30 transition-all group">
                            <span class="block text-sm font-semibold text-white mb-1 group-hover:text-brand-purple transition-colors">"Opportunities for designers"</span>
                            <span class="block text-xs text-brand-muted">UX research, branding, UI kits</span>
                        </button>
                    </div>
                </div>

            </div>

            <!-- Input Area -->
            <div class="mt-auto shrink-0 pt-4 relative z-10">
                <div class="relative max-w-4xl mx-auto">
                    <form id="aiChatForm" class="flex gap-2">
                        <div class="relative flex-grow">
                            <div class="absolute left-4 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-brand-purple/20 flex items-center justify-center">
                                <i data-lucide="sparkles" class="w-4 h-4 text-brand-purple"></i>
                            </div>
                            <!-- Added native CSRF mechanism if needed but assuming JS fetching handles it -->
                            <input type="text" id="aiInput" autocomplete="off" placeholder="Ask AI Scout..." class="w-full bg-brand-light border border-white/10 rounded-2xl pl-14 pr-12 py-4 text-base text-white placeholder:text-brand-muted focus:outline-none focus:border-brand-purple/50 focus:ring-4 focus:ring-brand-purple/10 transition-all shadow-xl">
                            <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-brand-muted hover:text-white transition-colors">
                                <i data-lucide="mic" class="w-5 h-5"></i>
                            </button>
                        </div>
                        <button type="submit" class="shrink-0 bg-white text-black hover:bg-gray-200 rounded-2xl px-6 font-bold transition-all flex items-center justify-center shadow-lg active:scale-95 disabled:opacity-50 disabled:pointer-events-none">
                            <i data-lucide="arrow-up" class="w-5 h-5"></i>
                        </button>
                    </form>
                    <div class="text-center mt-3 text-[10px] text-brand-muted">
                        AI Scout can make mistakes. Verify critical dates and requirements directly with DAOs.
                    </div>
                </div>
            </div>

        </main>
    </div>

    <%- include('partials/footer_scripts') %>

    <script>
        const chatForm = document.getElementById('aiChatForm');
        const aiInput = document.getElementById('aiInput');
        const chatHistory = document.getElementById('chatHistory');
        const welcomeState = document.getElementById('welcomeState');

        // Setup csrf token mapping safely inline
        const csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

        // Suggestion buttons
        document.querySelectorAll('.prompt-suggestion').forEach(btn => {
            btn.addEventListener('click', () => {
                const text = btn.querySelector('span').textContent.replace(/"/g, '');
                aiInput.value = text;
                chatForm.dispatchEvent(new Event('submit'));
            });
        });

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const query = aiInput.value.trim();
            if (!query) return;

            // Remove welcome state if present
            if (welcomeState && welcomeState.style.display !== 'none') {
                welcomeState.style.display = 'none';
            }

            // Append user message
            appendUserMessage(query);
            aiInput.value = '';

            // Append loading indicator
            const loadingId = 'loading-' + Date.now();
            appendLoading(loadingId);
            scrollToBottom();

            try {
                // Example API call to our backend (which uses Gemini)
                const response = await fetch('/api/ai/discover', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({ query })
                });

                const data = await response.json();
                
                // Remove loading
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();

                // Append AI Response
                appendAiResponse(data);
                scrollToBottom();
                lucide.createIcons();
                
            } catch (error) {
                console.error("AI Error:", error);
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();
                
                // Fallback / Error UI
                appendAiError("I'm sorry, I couldn't connect to the scouting network at the moment. Please try again later.");
                scrollToBottom();
            }
        });

        function appendUserMessage(text) {
            const html = `
                <div class="flex justify-end message-enter w-full max-w-4xl mx-auto">
                    <div class="bg-brand-light border border-white/5 rounded-2xl rounded-tr-sm px-5 py-3 text-white max-w-[80%] shadow-lg">
                        ${text}
                    </div>
                </div>
            `;
            chatHistory.insertAdjacentHTML('beforeend', html);
        }

        function appendLoading(id) {
            const html = `
                <div id="${id}" class="flex justify-start message-enter w-full max-w-4xl mx-auto">
                    <div class="flex gap-4 max-w-[90%]">
                        <div class="shrink-0 w-8 h-8 rounded-full bg-brand-purple/20 text-brand-purple flex items-center justify-center border border-brand-purple/30">
                            <i data-lucide="bot" class="w-4 h-4"></i>
                        </div>
                        <div class="bg-brand-light border border-white/5 rounded-2xl rounded-tl-sm px-5 py-4 shadow-lg min-w-[100px] flex items-center">
                            <div class="typing-indicator">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            chatHistory.insertAdjacentHTML('beforeend', html);
            lucide.createIcons();
        }

        function appendAiError(msg) {
            const html = `
                <div class="flex justify-start message-enter w-full max-w-4xl mx-auto">
                    <div class="flex gap-4 max-w-[90%]">
                        <div class="shrink-0 w-8 h-8 rounded-full bg-red-500/20 text-red-500 flex items-center justify-center border border-red-500/30">
                            <i data-lucide="alert-circle" class="w-4 h-4"></i>
                        </div>
                        <div class="bg-brand-light border border-white/5 rounded-2xl rounded-tl-sm px-5 py-4 text-brand-muted shadow-lg">
                            ${msg}
                        </div>
                    </div>
                </div>
            `;
            chatHistory.insertAdjacentHTML('beforeend', html);
            lucide.createIcons();
        }

        function appendAiResponse(data) {
            const summary = data.summary || "Here are some opportunities that match your request based on the current ecosystem state.";
            
            // Build suggestion cards based on metadata
            let cardsHtml = '';
            
            // We use dummy matched opportunities logically inferred from AI response
            // Alternatively, in a real app, the backend would actually query the DB using the AI's filterHints
            if (data.recommendations && data.recommendations.length > 0) {
                cardsHtml = `
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
                        ${data.recommendations.map((rec, i) => `
                            <div class="p-4 rounded-xl bg-black/20 border border-white/5 hover:bg-white/5 transition-colors cursor-pointer group">
                                <div class="flex items-center gap-2 mb-2 text-xs font-bold uppercase tracking-wider text-brand-muted">
                                    <i data-lucide="zap" class="w-3 h-3 group-hover:text-brand-purple"></i> 
                                    ${data.daos && data.daos[i] ? data.daos[i] : 'Web3 DAO'}
                                </div>
                                <h4 class="text-white font-medium text-sm mb-2 group-hover:text-brand-purple transition-colors">${rec}</h4>
                                <div class="flex gap-1.5 flex-wrap mt-auto">
                                   ${(data.skills || []).slice(0, 2).map(skill => `<span class="px-2 py-0.5 rounded bg-brand-purple/10 text-brand-purple text-[10px] font-bold uppercase tracking-wider">${skill}</span>`).join('')}
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
            }

            const html = `
                <div class="flex justify-start message-enter w-full max-w-4xl mx-auto">
                    <div class="flex gap-4 max-w-[90%] w-full">
                        <div class="shrink-0 w-8 h-8 rounded-full bg-brand-purple/20 text-brand-purple flex items-center justify-center border border-brand-purple/30">
                            <i data-lucide="bot" class="w-4 h-4"></i>
                        </div>
                        <div class="bg-brand-light border border-white/5 rounded-2xl rounded-tl-sm p-5 shadow-lg w-full">
                            <p class="text-brand-text text-sm leading-relaxed">${summary}</p>
                            ${cardsHtml}
                            <div class="mt-4 pt-3 border-t border-white/5 flex gap-2">
                                <button class="text-xs font-medium text-brand-muted hover:text-white px-3 py-1.5 rounded bg-white/5 hover:bg-white/10 transition-colors">Apply Filters</button>
                                <button class="text-xs font-medium text-brand-muted hover:text-white px-3 py-1.5 rounded bg-white/5 hover:bg-white/10 transition-colors">Start New Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            chatHistory.insertAdjacentHTML('beforeend', html);
        }

        function scrollToBottom() {
            chatHistory.scrollTo({
                top: chatHistory.scrollHeight,
                behavior: 'smooth'
            });
        }
    </script>
</body>
</html>