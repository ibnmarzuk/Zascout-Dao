# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/zascout
# Development fallback MongoDB URI (local)
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/zascout_dev

# Zero Authority DAO API
ZADAO_API_BASE_URL=https://zeroauthoritydao.com/api
ZADAO_API_KEY=your_api_key_here
ZA_API_KEY=your_za_api_key_here

# Gemini AI
GEMINI_API_KEY=your_gemini_key_here

# App
SESSION_SECRET=your_session_secret_here
CACHE_TTL_SECONDS=300